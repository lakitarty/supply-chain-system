    gap: 8px;
    width: 100%;
    min-width: 0;
    margin: 0 0 6px;
    padding: 2px 0 7px;
    border: 0;
}

.purchasing-page #createView .purchasing-field {
    min-width: 0;
    gap: 3px;
}

.purchasing-page #createView .purchasing-field label {
    font-size: 9px !important;
