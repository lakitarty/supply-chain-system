.settings-page {
    max-width: 760px;
}

.settings-section {
    max-width: 540px;
    margin-top: 12px;
}

.settings-section .section-title {
    margin-bottom: 4px;
}

.settings-action-row {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 14px;
    min-height: 44px;
    padding: 7px 0;
    border-bottom: 1px solid var(--border-light);
}

.settings-action-row button {
    order: -1;
    flex: 0 0 112px;
    min-width: 112px;
    min-height: 32px;
    padding: 0 10px;
    font-size: 12px;
}

.settings-action-row span {
    min-width: 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.4;
}

@media (max-width: 520px) {
    .settings-section {
        max-width: 100%;
    }

    .settings-action-row {
        gap: 10px;
    }

    .settings-action-row button {
        flex-basis: 104px;
        min-width: 104px;
    }
}
.price-protection-section {
    max-width: 680px;
}

.settings-explainer {
    margin: 8px 0 14px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.55;
}

.price-protection-control {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--border-light);
}

.price-protection-control label {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    color: var(--text);
    font-size: 13px;
    line-height: 1.45;
}

.price-protection-control input[type="checkbox"] {
    width: 18px;
    height: 18px;
    flex: 0 0 18px;
    accent-color: var(--primary);
}

.price-protection-control button {
    flex: 0 0 auto;
    min-height: 34px;
    padding: 0 12px;
    font-size: 12px;
}

.settings-status {
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.45;
}

@media (max-width: 520px) {
    .price-protection-control {
        align-items: flex-start;
        flex-direction: column;
    }
}