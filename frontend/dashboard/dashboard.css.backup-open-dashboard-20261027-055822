.dashboard-page {
    box-sizing: border-box;
    width: 100%;
    max-width: none !important;
    margin: 0;
    padding: 20px clamp(18px, 2.2vw, 34px) 28px;
    color: var(--text, #17262b);
}

.dashboard-page *,
.dashboard-page *::before,
.dashboard-page *::after {
    box-sizing: border-box;
}

.dashboard-page .form-message:empty {
    display: none;
}

.dashboard-command-center {
    display: flex;
    flex-direction: column;
    gap: 17px;
    width: 100%;
    min-width: 0;
}

.dashboard-command-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    padding: 0 0 15px;
    border-bottom: 1px solid var(--border, #c9d3d6);
}

.dashboard-eyebrow,
.dashboard-panel-eyebrow {
    margin: 0 0 7px;
    color: var(--brand, #0f766e);
    font-size: 18px;
    font-weight: 750;
    letter-spacing: .1em;
    line-height: 0.9;
}

.dashboard-command-title {
    margin: 0;
    color: var(--text, #17262b);
    font-size: clamp(24px, 2.2vw, 31px);
    line-height: 1.2;
    letter-spacing: -.045em;
    font-weight: 750;
}

.dashboard-command-description {
    margin: 7px 0 0;
    color: var(--muted, #5b6b70);
    font-size: 12px;
    line-height: 1.6;
}

.dashboard-organization-label {
    flex: 0 0 auto;
    padding: 7px 10px;
    border: 1px solid var(--border, #c9d3d6);
    background: #fff;
    color: #42565c;
    font-size: 11px;
    font-weight: 650;
}

.dashboard-metric-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid var(--border, #c9d3d6);
    background: #fff;
}

.dashboard-metric {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 7px;
    padding: 13px 17px 14px;
    border-right: 1px solid var(--border-light, #e2e8ea);
}

.dashboard-metric:last-child {
    border-right: 0;
}

.dashboard-metric-label {
    color: var(--muted, #5b6b70);
    font-size: 11px;
    line-height: 1.45;
    font-weight: 600;
}

.dashboard-metric-value {
    color: var(--text, #17262b);
    font-size: clamp(22px, 2vw, 29px);
    line-height: 1.15;
    font-weight: 750;
    font-variant-numeric: tabular-nums;
}

.dashboard-metric.has-attention .dashboard-metric-value {
    color: #a44235;
}

.dashboard-command-workspace {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(330px, .9fr);
    align-items: stretch;
    gap: 17px;
    min-height: 450px;
}

.dashboard-panel {
    display: flex;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border, #c9d3d6);
    background: #fff;
}

.dashboard-panel-header {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    min-height: 67px;
    padding: 14px 17px;
    border-bottom: 1px solid var(--border, #c9d3d6);
}

.dashboard-panel-heading-copy {
    min-width: 0;
}

.dashboard-panel-eyebrow {
    margin-bottom: 4px;
    font-size: 9px;
}

.dashboard-panel-title {
    margin: 0;
    color: var(--text, #17262b);
    font-size: 16px;
    line-height: 1.35;
    font-weight: 750;
}

.dashboard-panel-count {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    min-width: 27px;
    height: 27px;
    padding: 0 8px;
    border: 1px solid #e8cbc7;
    background: #fbf1ef;
    color: #a44235;
    font-size: 11px;
    line-height: 1;
    font-weight: 750;
    font-variant-numeric: tabular-nums;
}

.dashboard-panel-body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-gutter: stable;
}

.dashboard-action-group + .dashboard-action-group {
    border-top: 1px solid var(--border, #c9d3d6);
}

.dashboard-group-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 17px;
    background: #f6f8f8;
    border-bottom: 1px solid #e6ebec;
}

.dashboard-group-title {
    margin: 0;
    color: #43565c;
    font-size: 11px;
    line-height: 1.4;
    font-weight: 750;
}

.dashboard-group-count {
    color: var(--muted, #5b6b70);
    font-size: 10px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
}

.dashboard-action-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 13px;
    padding: 14px 17px;
    border-bottom: 1px solid #e9eeee;
    border-left: 3px solid transparent;
}

.dashboard-action-row:last-child {
    border-bottom: 0;
}

.dashboard-action-row:hover {
    border-left-color: var(--brand, #0f766e);
    background: #f8fbfa;
}

.dashboard-action-copy {
    min-width: 0;
}

.dashboard-action-title {
    margin: 0;
    color: var(--text, #17262b);
    font-size: 12px;
    line-height: 1.5;
    font-weight: 700;
    overflow-wrap: anywhere;
}

.dashboard-action-detail {
    margin: 5px 0 0;
    color: var(--muted, #5b6b70);
    font-size: 11px;
    line-height: 1.65;
    overflow-wrap: anywhere;
}

.dashboard-row-action {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    padding: 6px 9px;
    border: 1px solid #cddbd9;
    background: #fff;
    color: var(--brand-dark, #115e59);
    font-size: 10px;
    line-height: 1.35;
    font-weight: 750;
    text-decoration: none;
    white-space: nowrap;
}

.dashboard-row-action:hover {
    border-color: var(--brand, #0f766e);
    background: var(--brand-soft, #e6f2f0);
}

.dashboard-row-action:focus-visible {
    outline: 2px solid var(--brand, #0f766e);
    outline-offset: 2px;
}

.dashboard-activity-list {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-gutter: stable;
}

.dashboard-activity-row {
    display: grid;
    grid-template-columns: 9px minmax(0, 1fr) auto;
    align-items: start;
    gap: 11px;
    padding: 15px 16px;
    border-bottom: 1px solid #e9eeee;
}

.dashboard-activity-row:last-child {
    border-bottom: 0;
}

.dashboard-activity-marker {
    width: 7px;
    height: 7px;
    margin-top: 5px;
    border-radius: 50%;
    background: #6c9e97;
    box-shadow: 0 0 0 3px #edf5f3;
}

.dashboard-activity-copy {
    min-width: 0;
}

.dashboard-activity-title {
    margin: 0;
    color: var(--text, #17262b);
    font-size: 11px;
    line-height: 1.5;
    font-weight: 700;
    overflow-wrap: anywhere;
}

.dashboard-activity-detail {
    margin: 5px 0 0;
    color: var(--muted, #5b6b70);
    font-size: 10px;
    line-height: 1.6;
    overflow-wrap: anywhere;
    white-space: pre-line;
}

.dashboard-activity-date {
    display: block;
    margin-top: 7px;
    color: #77878b;
    font-size: 9px;
    line-height: 1.5;
}

.dashboard-activity-row .dashboard-row-action {
    padding: 4px 6px;
    border-color: transparent;
    background: transparent;
}

.dashboard-activity-row .dashboard-row-action:hover {
    background: var(--brand-soft, #e6f2f0);
}

.dashboard-zero-state {
    display: flex;
    min-height: 230px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 28px;
    text-align: center;
}

.dashboard-zero-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 37px;
    height: 37px;
    margin-bottom: 12px;
    border: 1px solid #c8e0d6;
    border-radius: 50%;
    background: #eef7f2;
    color: #216a4e;
    font-size: 20px;
}

.dashboard-zero-state h3 {
    margin: 0;
    color: var(--text, #17262b);
    font-size: 14px;
}

.dashboard-zero-state p,
.dashboard-muted-message {
    max-width: 340px;
    margin: 7px 0 0;
    color: var(--muted, #5b6b70);
    font-size: 11px;
    line-height: 1.7;
}

.dashboard-empty {
    margin: 0;
    padding: 22px 17px;
    color: var(--muted, #5b6b70);
    font-size: 11px;
    line-height: 1.7;
}

.dashboard-load-error {
    margin-top: 18px;
    border: 1px solid #efc4c2;
    background: #fdf0ef;
    color: #a13732;
}

.dashboard-alert-warning {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 13px;
    margin: 0 0 15px;
    padding: 12px 15px;
    border: 1px solid #e5c985;
    border-left: 3px solid #bd8529;
    background: #fff9eb;
    color: #79571c;
    font-size: 11px;
    line-height: 1.6;
}

.dashboard-alert-warning strong {
    font-weight: 750;
}

.dashboard-alert-warning a {
    margin-left: auto;
    color: #79571c;
    font-size: 11px;
    font-weight: 750;
    text-decoration: none;
}

.dashboard-alert-warning a:hover {
    text-decoration: underline;
}

@media (min-width: 1400px) {
    .dashboard-command-workspace {
        grid-template-columns: minmax(0, 1.35fr) minmax(360px, .85fr);
        min-height: min(62vh, 720px);
    }

    .dashboard-action-row {
        padding-top: 16px;
        padding-bottom: 16px;
    }
}

@media (max-width: 1000px) {
    .dashboard-command-workspace {
        grid-template-columns: minmax(0, 1fr);
    }

    .dashboard-panel {
        min-height: 320px;
    }

    .dashboard-activity-list {
        max-height: 440px;
    }
}

@media (max-width: 620px) {
    .dashboard-page {
        padding: 17px 14px 24px;
    }

    .dashboard-command-header {
        align-items: flex-start;
        flex-direction: column;
        gap: 10px;
    }

    .dashboard-command-title {
        font-size: 25px;
    }

    .dashboard-metric-strip {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .dashboard-metric:nth-child(2n) {
        border-right: 0;
    }

    .dashboard-metric:nth-child(-n+2) {
        border-bottom: 1px solid var(--border-light, #e2e8ea);
    }

    .dashboard-action-row {
        grid-template-columns: minmax(0, 1fr);
        gap: 8px;
    }

    .dashboard-action-row .dashboard-row-action {
        justify-self: start;
    }

    .dashboard-activity-row {
        grid-template-columns: 9px minmax(0, 1fr);
    }

    .dashboard-activity-row .dashboard-row-action {
        grid-column: 2;
        justify-self: start;
    }

    .dashboard-alert-warning a {
        margin-left: 0;
    }
}

