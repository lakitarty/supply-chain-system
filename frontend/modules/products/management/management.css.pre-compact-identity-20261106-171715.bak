.product-management-page {
    width: min(100% - 64px, 1240px);
    margin: 0 auto;
    padding: 30px 0 55px;
    color: #17231d;
}

.product-management-page > .page-title {
    margin: 0 0 27px;
    color: #17231d;
    font-size: 27px;
    font-weight: 700;
    letter-spacing: -0.55px;
}

/* Existing product selector */

.product-management-page > .page-section:first-of-type {
    display: grid;
    grid-template-columns: 205px minmax(0, 1fr);
    align-items: center;
    gap: 0 30px;
    margin: 0 0 34px;
    padding: 16px 20px;
    background: #f0f3eb;
}

.product-management-page > .page-section:first-of-type .section-title {
    grid-column: 1;
    grid-row: 1 / 3;
    margin: 0;
    color: #bf6835;
    font-size: 14px;
    font-weight: 700;
}

.product-management-page > .page-section:first-of-type .form-group {
    grid-column: 2;
    max-width: 680px;
    margin: 0;
}

.product-management-page > .page-section:first-of-type .field-hint {
    grid-column: 2;
    margin: 6px 0 0;
}

/* Main product form */

.product-management-page > .page-section:nth-of-type(2) {
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
}

.product-management-page > .page-section:nth-of-type(2) > .section-title {
    margin: 0 0 25px;
    padding: 0;
    color: #17231d;
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.3px;
}

/* Form field organisation */

.product-management-page #productForm .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 34px;
    row-gap: 18px;
}

.product-management-page .form-grid-heading {
    grid-column: 1 / -1;
    margin: 12px 0 1px;
    color: #bf6835;
    font-size: 12px;
    font-weight: 750;
    letter-spacing: 0.075em;
    line-height: 1.4;
    text-transform: uppercase;
}

.product-management-page .form-grid-heading:first-child {
    margin-top: 0;
}

.product-management-page .form-group {
    min-width: 0;
    margin: 0;
}

.product-management-page .form-group label {
    display: block;
    margin: 0 0 7px;
    color: #202923;
    font-size: 13px;
    font-weight: 650;
    line-height: 1.4;
}

.product-management-page .form-group input,
.product-management-page .form-group select,
.product-management-page .form-group textarea {
    width: 100%;
    max-width: 100%;
    border: 1px solid #aebbb1;
    border-radius: 5px;
    background: #ffffff;
    color: #17231d;
    font-family: inherit;
    font-size: 14px;
    transition: border-color 140ms ease, box-shadow 140ms ease;
}

.product-management-page .form-group input,
.product-management-page .form-group select {
    height: 43px;
    padding: 0 12px;
}

.product-management-page .form-group textarea {
    min-height: 112px;
    padding: 11px 12px;
    line-height: 1.55;
    resize: vertical;
}

.product-management-page .form-group input::placeholder,
.product-management-page .form-group textarea::placeholder {
    color: #536159;
    opacity: 1;
}

.product-management-page .form-group input:hover,
.product-management-page .form-group select:hover,
.product-management-page .form-group textarea:hover {
    border-color: #71877a;
}

.product-management-page .form-group input:focus,
.product-management-page .form-group select:focus,
.product-management-page .form-group textarea:focus {
    border-color: #0f766e;
    outline: none;
    box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.13);
}

/* Supporting information */

.product-management-page .field-hint {
    margin: 7px 0 0;
    color: #3f4b43;
    font-size: 12px;
    line-height: 1.5;
}

.product-management-page .optional {
    color: #3f4b43;
    font-size: 12px;
    font-weight: 400;
}

.product-management-page #productImage {
    height: auto;
    min-height: 43px;
    padding: 7px 9px;
    background: #ffffff;
}

.product-management-page #productImage::file-selector-button {
    margin-right: 12px;
    padding: 7px 11px;
    border: 0;
    border-radius: 4px;
    background: #e9f1ed;
    color: #174d3d;
    font: inherit;
    font-size: 12px;
    font-weight: 650;
    cursor: pointer;
}

.product-management-page .form-detail-heading {
    margin: 27px 0 14px;
    color: #bf6835;
    font-size: 12px;
    font-weight: 750;
    letter-spacing: 0.075em;
    text-transform: uppercase;
}

.product-management-page #productForm > .form-group {
    margin-top: 0;
}

.product-management-page #imagePreviewContainer {
    margin: 17px 0 0;
    padding: 0;
}

.product-management-page #imagePreviewLabel {
    margin-bottom: 10px;
    color: #202923;
    font-weight: 650;
}

.product-management-page #imagePreview {
    display: block;
    width: auto;
    max-width: 320px;
    height: 210px;
    object-fit: contain;
    border-radius: 5px;
    background: #f3f4ed;
}

.product-management-page #productMessage {
    margin-top: 14px;
}

/* Save and cancel actions */

.product-management-page .form-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 27px;
    padding: 0;
    border: 0;
}

.product-management-page .form-actions .primary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: auto;
    min-width: 165px;
    height: 43px;
    padding: 0 20px;
    border: 1px solid #0f766e;
    border-radius: 5px;
    background: #0f766e;
    color: #ffffff;
    font-size: 13px;
    font-weight: 650;
    transition: background 140ms ease, border-color 140ms ease;
}

.product-management-page .form-actions .primary-button:hover {
    border-color: #115e59;
    background: #115e59;
}

.product-management-page #cancelEditButton {
    min-height: 43px;
    padding: 0 17px;
    border: 1px solid #87968c;
    border-radius: 5px;
    background: transparent;
    color: #26372d;
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
}

.product-management-page #cancelEditButton:hover {
    border-color: #0f766e;
    background: #edf4f0;
}

.product-management-page button:focus-visible {
    outline: 3px solid rgba(15, 118, 110, 0.24);
    outline-offset: 3px;
}

.product-management-page button:disabled {
    cursor: not-allowed;
    opacity: 0.65;
}

.product-management-page [hidden] {
    display: none !important;
}