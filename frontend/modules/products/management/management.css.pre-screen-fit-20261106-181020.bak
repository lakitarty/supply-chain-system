.product-management-page {
    width: min(100% - 40px, 1180px);
    margin: 0 auto;
    padding: 8px 0 12px;
    color: #17262b;
}

/* Page heading and product selector */

.product-page-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
    margin-bottom: 8px;
}

.product-breadcrumb {
    margin-bottom: 3px;
    color: #52616a;
    font-size: 10px;
}

.product-management-page > .product-page-heading .page-title {
    margin: 0;
    color: #17262b;
    font-size: 21px;
    font-weight: 650;
    letter-spacing: -0.3px;
}

.product-selector {
    display: grid;
    grid-template-columns: auto minmax(220px, 290px);
    align-items: center;
    gap: 9px;
}

.product-selector label {
    color: #293941;
    font-size: 11px;
    font-weight: 600;
}

.product-selector select {
    width: 100%;
    height: 32px;
    padding: 0 9px;
    border: 1px solid #bac5c8;
    border-radius: 3px;
    background: #ffffff;
    color: #17262b;
    font-family: inherit;
    font-size: 11px;
}

/* Product object header */

.product-object-header {
    display: flex;
    align-items: center;
    min-height: 52px;
    padding: 8px 15px;
    border: 1px solid #d8dfe1;
    background: #ffffff;
}

.object-header-eyebrow {
    margin-bottom: 2px;
    color: #52616a;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.07em;
}

.product-object-header h2 {
    margin: 0;
    color: #17262b;
    font-size: 17px;
    font-weight: 650;
}

.product-object-header p {
    margin: 3px 0 0;
    color: #52616a;
    font-size: 10px;
}

/* White object sections */

.object-section {
    min-width: 0;
    margin: 0;
    padding: 10px 15px 12px;
    border: 1px solid #d8dfe1;
    border-top: 0;
    background: #ffffff;
}

.object-section-heading {
    display: flex;
    align-items: center;
    margin-bottom: 9px;
}

.object-section-heading h3 {
    margin: 0;
    padding: 0;
    color: #17262b;
    font-size: 13px;
    font-weight: 650;
}

.object-section-heading p {
    margin: 2px 0 0;
    color: #52616a;
    font-size: 10px;
}

/* General information */

.general-information-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 200px;
    align-items: center;
    gap: 24px;
}

.general-information-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 20px;
}

.general-information-fields .form-group {
    grid-template-columns: 105px minmax(0, 1fr);
}

.product-image-panel {
    display: grid;
    grid-template-columns: 1fr;
    gap: 5px;
    min-width: 0;
    padding-left: 15px;
    border-left: 1px solid #e0e5e7;
    background: #ffffff;
}

.product-image-heading {
    color: #293941;
    font-size: 11px;
    font-weight: 600;
}

.product-image-panel .image-upload-label {
    margin: 0;
    color: #293941;
    font-size: 10px;
    font-weight: 600;
}

.product-image-panel .image-upload-label span {
    color: #52616a;
    font-weight: 400;
}

.product-management-page #productImage {
    height: auto;
    min-height: 29px;
    padding: 4px;
    border: 1px solid #bac5c8;
    border-radius: 3px;
    background: #ffffff;
    font-size: 9px;
}

.product-management-page #productImage::file-selector-button {
    margin-right: 5px;
    padding: 4px 7px;
    border: 0;
    border-radius: 2px;
    background: #edf1f2;
    color: #293941;
    font: inherit;
    cursor: pointer;
}

.product-management-page #imagePreviewContainer:not([hidden]) {
    margin-bottom: 4px;
}

.product-management-page #imagePreviewLabel {
    margin: 0 0 3px;
    color: #52616a;
    font-size: 9px;
}

.product-management-page #imagePreview {
    display: block;
    width: 100%;
    max-width: 100px;
    height: 66px;
    object-fit: contain;
    border: 1px solid #e1e5e7;
    border-radius: 2px;
    background: #ffffff;
}

/* Product setup and commercial information */

.product-detail-columns {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: stretch;
    gap: 8px;
}

.product-detail-columns .object-section {
    min-width: 0;
    padding: 10px 12px;
}

.product-detail-columns:has(#commercial-tax[hidden]) {
    grid-template-columns: minmax(0, 1fr);
}

.object-field-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 11px 13px;
}

.product-management-page #commercial-tax .object-field-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 9px;
}

/* Form controls */

.product-management-page .form-group {
    display: grid;
    grid-template-columns: minmax(95px, 112px) minmax(0, 1fr);
    align-items: center;
    column-gap: 8px;
    min-width: 0;
    margin: 0;
}

.product-management-page .form-group > label {
    color: #293941;
    font-size: 10px;
    font-weight: 600;
    line-height: 1.4;
}

.product-management-page .form-group input,
.product-management-page .form-group select,
.product-management-page .form-group textarea {
    width: 100%;
    min-width: 0;
    border: 1px solid #bac5c8;
    border-radius: 3px;
    background: #ffffff;
    color: #17262b;
    font-family: inherit;
    font-size: 11px;
    transition: border-color 120ms ease, box-shadow 120ms ease;
}

.product-management-page .form-group input,
.product-management-page .form-group select {
    height: 30px;
    padding: 0 7px;
}

.product-management-page .form-group textarea {
    min-height: 51px;
    padding: 7px 8px;
    resize: none;
    line-height: 1.4;
}

.product-management-page .form-group input::placeholder,
.product-management-page .form-group textarea::placeholder {
    color: #52616a;
    opacity: 1;
}

.product-management-page .form-group input:focus,
.product-management-page .form-group select:focus,
.product-management-page .form-group textarea:focus,
.product-management-page .product-selector select:focus {
    border-color: #0f766e;
    outline: none;
    box-shadow: 0 0 0 2px rgba(15, 118, 110, 0.11);
}

.product-management-page .field-hint {
    grid-column: 2;
    margin: 2px 0 0;
    color: #52616a;
    font-size: 9px;
    line-height: 1.3;
}

/* Description */

.description-field {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    align-items: center;
    gap: 9px;
}

.description-field label {
    color: #293941;
    font-size: 11px;
    font-weight: 600;
}

.description-field textarea {
    width: 100%;
    min-height: 49px;
    max-height: 54px;
    padding: 7px 8px;
    border: 1px solid #bac5c8;
    border-radius: 3px;
    color: #17262b;
    font-family: inherit;
    font-size: 11px;
    resize: none;
}

.description-field textarea:focus {
    border-color: #0f766e;
    outline: none;
    box-shadow: 0 0 0 2px rgba(15, 118, 110, 0.11);
}

/* Action bar */

.product-management-page #productMessage {
    margin: 5px 0;
    font-size: 10px;
}

.product-action-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 39px;
    margin-top: 7px;
    padding: 4px 12px;
    border: 1px solid #d8dfe1;
    background: #ffffff;
}

.action-context {
    color: #52616a;
    font-size: 10px;
}

.product-management-page .form-actions {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 0;
}

.product-management-page .form-actions .primary-button {
    min-width: 112px;
    height: 30px;
    padding: 0 13px;
    border: 1px solid #0f766e;
    border-radius: 3px;
    background: #0f766e;
    color: #ffffff;
    font-family: inherit;
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
}

.product-management-page .form-actions .primary-button:hover {
    border-color: #115e59;
    background: #115e59;
}

.product-management-page #cancelEditButton {
    min-height: 30px;
    padding: 0 11px;
    border: 1px solid #89979d;
    border-radius: 3px;
    background: #ffffff;
    color: #293941;
    font-family: inherit;
    font-size: 11px;
    cursor: pointer;
}

.product-management-page #cancelEditButton:hover {
    background: #edf1f2;
}

.product-management-page button:focus-visible {
    outline: 2px solid #0f766e;
    outline-offset: 2px;
}

.product-management-page button:disabled {
    cursor: not-allowed;
    opacity: 0.65;
}

.product-management-page [hidden] {
    display: none !important;
}