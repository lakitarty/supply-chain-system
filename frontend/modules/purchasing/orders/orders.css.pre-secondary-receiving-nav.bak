.purchasing-page{max-width:1560px;margin:0 auto;padding-bottom:42px;color:var(--text,#1f2937)}
.purchasing-page [hidden]{display:none!important}
.purchasing-page button,.purchasing-page input,.purchasing-page select{font:inherit}
.purchasing-page-heading{display:flex;align-items:center;justify-content:space-between;gap:22px;margin-bottom:20px}
.purchasing-page-heading h1{margin:0;font-size:clamp(25px,3vw,32px);letter-spacing:-.025em}
.purchasing-page-heading p:last-child{margin:6px 0 0;color:var(--muted,#64748b);line-height:1.5}
.purchasing-eyebrow{margin:0 0 5px;color:var(--brand,#0f766e);font-size:11px;font-weight:750;letter-spacing:.1em}
.purchasing-new-button{width:auto;min-width:150px;display:inline-flex;align-items:center;justify-content:center;gap:8px;white-space:nowrap}
.purchasing-new-button span{font-size:20px;line-height:1}
.purchasing-nav{display:flex;align-items:stretch;gap:4px;overflow-x:auto;padding:6px 0 12px;border-bottom:1px solid var(--border,#dbe4e3);margin-bottom:17px;scrollbar-width:thin}
.purchasing-nav-button{position:relative;display:flex;flex:0 0 auto;align-items:center;gap:8px;min-height:42px;padding:7px 12px;border:1px solid transparent;border-radius:6px;background:transparent;color:var(--muted,#64748b);cursor:pointer;white-space:nowrap}
.purchasing-nav-button:hover{background:var(--surface-muted,#f8fafc);color:var(--text,#1f2937)}
.purchasing-nav-button.is-active{background:var(--surface,#fff);border-color:var(--brand,#0f766e);color:var(--brand,#0f766e);font-weight:700}
.purchasing-nav-icon{display:inline-flex;width:22px;height:22px;align-items:center;justify-content:center;font-size:21px;line-height:1;font-weight:500}
.purchasing-nav-label{font-size:12px}
.purchasing-nav-count{display:inline-flex;min-width:19px;height:19px;align-items:center;justify-content:center;padding:0 5px;border-radius:10px;background:var(--brand,#0f766e);color:#fff;font-size:10px;font-weight:700}
.purchasing-nav-separator{flex:0 0 1px;margin:5px 5px;background:var(--border,#dbe4e3)}
.purchasing-status{min-height:0;margin:0 0 13px;color:var(--muted,#64748b);font-size:13px;line-height:1.5}
.purchasing-status:empty{display:none}
.purchasing-status.is-error,.purchasing-status.is-success,.purchasing-status.is-pending{padding:10px 12px;border-left:3px solid var(--brand,#0f766e);background:var(--surface-muted,#f8fafc)}
.purchasing-status.is-error{border-left-color:var(--error,#b42318);color:var(--error,#b42318);background:var(--error-bg,#fef3f2)}
.purchasing-status.is-success{border-left-color:var(--brand,#0f766e)}
.purchasing-section-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin:0 0 17px}
.purchasing-section-heading h2{margin:0;font-size:20px;letter-spacing:-.015em}
.purchasing-section-heading h3{margin:0;font-size:16px}
.purchasing-section-heading p{margin:6px 0 0;color:var(--muted,#64748b);font-size:13px;line-height:1.5}
.purchasing-state-chip{display:inline-flex;align-items:center;min-height:27px;padding:4px 9px;border:1px solid var(--border,#dbe4e3);border-radius:4px;color:var(--muted,#64748b);font-size:11px;font-weight:700;white-space:nowrap}
.purchasing-fields{display:grid;grid-template-columns:1fr 1.4fr 1fr;gap:15px;padding:0 0 21px;border-bottom:1px solid var(--border,#dbe4e3)}
.purchasing-field{display:flex;flex-direction:column;gap:7px;min-width:0}
.purchasing-field label,.purchasing-register-search span{color:var(--text,#1f2937);font-size:12px;font-weight:700}
.purchasing-field input,.purchasing-field select,.purchasing-register-search input{width:100%;min-width:0;min-height:40px;padding:8px 10px;border:1px solid var(--border,#dbe4e3);border-radius:5px;background:var(--surface,#fff);color:var(--text,#1f2937);font-size:13px}
.purchasing-field input:focus,.purchasing-field select:focus,.purchasing-register-search input:focus,.purchasing-quantity-input:focus{outline:2px solid rgba(15,118,110,.2);border-color:var(--brand,#0f766e)}
.purchasing-catalogue{margin-top:22px}
.purchasing-catalogue-heading{align-items:center;margin-bottom:13px}
.purchasing-subtle-count{color:var(--muted,#64748b);font-size:12px;white-space:nowrap}
.purchasing-catalogue-tools{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin-bottom:14px}
.purchasing-search-field{width:min(100%,440px)}
.purchasing-hint{max-width:460px;margin:0 0 9px;color:var(--muted,#64748b);font-size:12px;line-height:1.5}
.purchasing-notice{margin:0 0 12px;padding:10px 12px;border-left:3px solid #b7791f;background:#fffbeb;color:#854d0e;font-size:12px;line-height:1.5}
.purchasing-stale-lines{margin:0 0 13px;padding:12px;border:1px solid #e9b6a7;background:#fff7f3}
.purchasing-stale-lines h4{margin:0 0 8px;color:#9a3412;font-size:13px}
.purchasing-stale-line{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:7px 0;border-top:1px solid #f1d2c9;font-size:12px}
.purchasing-stale-line:first-of-type{border-top:0}
.purchasing-stale-line strong{display:block;margin-bottom:3px}
.purchasing-stale-line small{color:#9a3412;line-height:1.4}
.purchasing-table-wrap{width:100%;overflow:auto;border-top:1px solid var(--border,#dbe4e3);border-bottom:1px solid var(--border,#dbe4e3)}
.purchasing-table{width:100%;border-collapse:collapse;color:var(--text,#1f2937);font-size:12px}
.purchasing-table th,.purchasing-table td{padding:11px 12px;border-bottom:1px solid var(--border,#e2e8f0);text-align:left;vertical-align:middle}
.purchasing-table th{background:var(--surface-muted,#f8fafc);color:var(--muted,#475569);font-size:10px;font-weight:750;letter-spacing:.045em;text-transform:uppercase;white-space:nowrap}
.purchasing-table tbody tr:last-child td{border-bottom:0}
.purchasing-table tbody tr:hover td{background:rgba(148,163,184,.045)}
.purchasing-orders-table tbody tr[data-open-order-row]{cursor:pointer}
.purchasing-orders-table tbody tr[data-open-order-row]:focus-visible{outline:2px solid var(--brand,#0f766e);outline-offset:-2px}
.purchasing-empty-cell{padding:28px 14px!important;color:var(--muted,#64748b);text-align:center!important;line-height:1.55}
.purchasing-product-title{min-width:180px;font-size:12px;font-weight:700;line-height:1.45}
.purchasing-product-subtitle{display:block;margin-top:3px;color:var(--muted,#64748b);font-size:11px;font-weight:400;line-height:1.45}
.purchasing-offer-price{font-weight:750;white-space:nowrap;font-variant-numeric:tabular-nums}
.purchasing-offer-basis{display:block;margin-top:4px;color:var(--muted,#64748b);font-size:10px}
.purchasing-term{display:block;white-space:nowrap}
.purchasing-term+.purchasing-term{margin-top:4px;color:var(--muted,#64748b);font-size:10px}
.purchasing-quantity-input{width:86px;min-height:34px;padding:5px 7px;border:1px solid var(--border,#cbd5e1);border-radius:5px;background:var(--surface,#fff);color:var(--text,#1f2937);font-size:13px;font-variant-numeric:tabular-nums}
.purchasing-quantity-input[aria-invalid="true"]{border-color:#b42318;background:#fff7f6}
.purchasing-quantity-hint{display:block;max-width:135px;margin-top:4px;color:var(--muted,#64748b);font-size:10px;line-height:1.35}
.purchasing-row-total{font-weight:750;white-space:nowrap;font-variant-numeric:tabular-nums}
.purchasing-row-note{display:block;max-width:190px;margin-top:4px;color:#9a3412;font-size:10px;line-height:1.35;white-space:normal}
.purchasing-editor-footer{display:flex;align-items:center;justify-content:space-between;gap:22px;padding:17px 0 23px;border-bottom:1px solid var(--border,#dbe4e3)}
.purchasing-total-block{display:flex;flex-direction:column;gap:4px}
.purchasing-total-block>span{color:var(--muted,#64748b);font-size:12px;font-weight:600}
.purchasing-total-block strong{font-size:25px;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
.purchasing-total-block small{max-width:620px;color:var(--muted,#64748b);font-size:11px;line-height:1.45}
.purchasing-editor-actions{display:flex;align-items:center;gap:10px}
.purchasing-editor-actions .primary-button,.purchasing-editor-actions .secondary-button{width:auto;min-width:130px;height:42px}
.purchasing-page .secondary-button{display:inline-flex;align-items:center;justify-content:center;min-height:38px;padding:8px 12px;border:1px solid var(--border,#cbd5e1);border-radius:5px;background:var(--surface,#fff);color:var(--text,#334155);font-size:12px;font-weight:650;cursor:pointer}
.purchasing-page .secondary-button:hover{background:var(--surface-muted,#f8fafc);border-color:#94a3b8}
.purchasing-page button:disabled{opacity:.5;cursor:not-allowed}
.purchasing-register-tools{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin-bottom:13px}
.purchasing-register-search{display:flex;flex-direction:column;gap:6px;width:min(100%,370px)}
.purchasing-orders-table{min-width:1050px}
.purchasing-status-badge{display:inline-flex;padding:4px 7px;border:1px solid var(--border,#dbe4e3);border-radius:4px;background:var(--surface,#fff);color:var(--text,#334155);font-size:10px;font-weight:750;white-space:nowrap}
.purchasing-status-badge.status-submitted,.purchasing-status-badge.status-confirmed{border-color:#a7d6ca;background:#effaf6;color:#116149}
.purchasing-status-badge.status-cancelled{border-color:#f0c5c0;background:#fff4f2;color:#9f2d20}
.purchasing-status-badge.status-delivered{border-color:#b6c8ef;background:#f1f5ff;color:#2e4d9a}
.purchasing-status-badge.status-draft{border-color:#e7d6a1;background:#fffbeb;color:#854d0e}
.purchasing-action-group{display:flex;align-items:center;gap:10px;white-space:nowrap}
.purchasing-text-button{padding:4px 0;border:0;background:transparent;color:var(--brand,#0f766e);font-size:11px;font-weight:750;cursor:pointer}
.purchasing-text-button:hover{text-decoration:underline}
.purchasing-detail{margin-top:27px;padding-top:19px;border-top:2px solid var(--border,#dbe4e3)}
.purchasing-detail-meta{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px 20px;margin:0 0 17px;padding:12px 0}
.purchasing-detail-label{display:block;color:var(--muted,#64748b);font-size:11px}
.purchasing-detail-value{display:block;margin-top:5px;font-size:12px;font-weight:700;overflow-wrap:anywhere}
.purchasing-placeholder{display:flex;align-items:flex-start;gap:18px;min-height:180px;padding:28px 8px}
.purchasing-placeholder-symbol{display:flex;flex:0 0 48px;width:48px;height:48px;align-items:center;justify-content:center;border:1px solid var(--border,#dbe4e3);border-radius:8px;color:var(--brand,#0f766e);font-size:27px}
.purchasing-placeholder h2{margin:0;font-size:21px}
.purchasing-placeholder p{max-width:700px;color:var(--muted,#64748b);font-size:13px;line-height:1.65}
.purchasing-placeholder-note{margin-top:16px;padding-top:12px;border-top:1px solid var(--border,#dbe4e3);font-size:12px!important}
@media(max-width:900px){.purchasing-fields{grid-template-columns:1fr 1fr}.purchasing-detail-meta{grid-template-columns:1fr 1fr}.purchasing-catalogue-tools{align-items:flex-start;flex-direction:column;gap:8px}.purchasing-hint{margin:0}}
@media(max-width:600px){.purchasing-page-heading{align-items:flex-start;flex-direction:column}.purchasing-new-button{width:100%}.purchasing-fields{grid-template-columns:1fr}.purchasing-editor-footer{align-items:stretch;flex-direction:column}.purchasing-editor-actions{display:grid;grid-template-columns:1fr 1fr}.purchasing-editor-actions .primary-button,.purchasing-editor-actions .secondary-button{min-width:0;width:100%}.purchasing-section-heading{gap:10px}.purchasing-register-tools{align-items:stretch;flex-direction:column}.purchasing-register-search{width:100%}.purchasing-detail-meta{grid-template-columns:1fr 1fr}.purchasing-placeholder{gap:12px;padding:20px 0}.purchasing-placeholder-symbol{flex-basis:38px;width:38px;height:38px}.purchasing-nav-button{padding:7px 9px}.purchasing-nav-label{font-size:11px}}
/* Purchasing full-width workspace and compact icon rail */
.purchasing-page {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 10px 12px 18px !important;
    box-sizing: border-box;
    min-height: calc(100dvh - 120px);
}
.purchasing-page-heading { margin-bottom: 10px; }
.purchasing-page-heading .purchasing-eyebrow,
.purchasing-page-heading #purchasingSubtitle,
.purchasing-main-content .purchasing-section-heading p,
.purchasing-main-content .purchasing-catalogue-tools,
.purchasing-main-content .purchasing-hint,
.purchasing-main-content .purchasing-placeholder-note,
.purchasing-main-content .purchasing-placeholder .purchasing-eyebrow { display: none !important; }
.purchasing-page-heading #newLpoButton { display: none !important; }
.purchasing-workspace {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    align-items: stretch;
    gap: 12px;
    width: 100%;
    min-width: 0;
    min-height: calc(100dvh - 176px);
}
.purchasing-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 7px;
    width: 48px;
    min-width: 48px;
    padding: 0 7px 12px 0;
    margin: 0;
    overflow: visible;
    border: 0;
    border-right: 1px solid var(--border, #dbe4e3);
    box-sizing: border-box;
    scrollbar-width: none;
}
.purchasing-nav-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    width: 100%;
}
.purchasing-nav-button {
    position: relative;
    display: inline-flex;
    flex: 0 0 40px;
    align-items: center;
    justify-content: center;
    width: 40px;
    min-width: 40px;
    height: 40px;
    min-height: 40px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 7px;
    background: transparent;
    color: var(--muted, #64748b);
    cursor: pointer;
}
.purchasing-nav-button:hover { background: var(--surface-muted, #f8fafc); color: var(--text, #1f2937); }
.purchasing-nav-button.is-active {
    color: var(--brand, #0f766e);
    background: var(--surface, #fff);
    border-color: var(--brand, #0f766e);
}
.purchasing-nav-icon {
    display: block;
    flex: 0 0 21px;
    width: 21px;
    height: 21px;
    margin: 0;
    font-size: 0;
    line-height: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
}
.purchasing-nav-label { display: none !important; }
.purchasing-nav-count {
    position: absolute;
    top: -4px;
    right: -4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 16px;
    height: 16px;
    padding: 0 3px;
    border: 1px solid var(--surface, #fff);
    border-radius: 9px;
    background: var(--brand, #0f766e);
    color: #fff;
    font-size: 9px;
    font-weight: 750;
}
.purchasing-nav-count[hidden] { display: none !important; }
.purchasing-nav-separator {
    display: block;
    flex: 0 0 1px;
    width: 27px;
    height: 1px;
    margin: 5px 0 6px;
    background: var(--border, #dbe4e3);
}
.purchasing-main-content {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    min-width: 0;
    width: 100%;
    min-height: calc(100dvh - 176px);
}
.purchasing-view {
    flex: 1 0 auto;
    width: 100%;
    max-width: none;
    min-width: 0;
    min-height: calc(100dvh - 248px);
    box-sizing: border-box;
}
.purchasing-catalogue { margin-top: 9px; }
.purchasing-catalogue-table { min-width: 900px; }
.purchasing-quantity-hint { display: none !important; }
.purchasing-detail { width: 100%; min-width: 0; }
.purchasing-placeholder { min-height: calc(100dvh - 248px); align-items: flex-start; }
.purchasing-placeholder-symbol { display: none !important; }
.purchasing-placeholder h2 { margin: 0; }
.purchasing-placeholder .purchasing-state-chip { margin-top: 12px; }
.purchasing-page [hidden] { display: none !important; }
@media (max-width: 640px) {
    .purchasing-page { padding: 8px 8px 16px !important; }
    .purchasing-workspace { grid-template-columns: 42px minmax(0, 1fr); gap: 8px; }
    .purchasing-nav { width: 42px; min-width: 42px; padding-right: 4px; }
    .purchasing-nav-button { width: 36px; min-width: 36px; height: 36px; min-height: 36px; flex-basis: 36px; }
    .purchasing-nav-icon { width: 19px; height: 19px; flex-basis: 19px; }
    .purchasing-view { min-height: calc(100dvh - 210px); }
}

/* Purchasing icon actions dock into the shared secondary navigation */
.purchasing-workspace {
    display: flex !important;
    flex-direction: column !important;
    align-items: stretch !important;
    gap: 0 !important;
    grid-template-columns: none !important;
    width: 100% !important;
    min-width: 0;
}

#shell .purchasing-nav,
#shell .purchasing-shell-secondary-nav {
    display: flex !important;
    position: relative;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    align-items: stretch !important;
    justify-content: flex-start !important;
    gap: 4px !important;
    width: 100% !important;
    max-width: 100%;
    min-width: 0 !important;
    min-height: 38px !important;
    height: auto !important;
    margin: 0 !important;
    padding: 0 var(--gutter, 16px) !important;
    overflow-x: auto !important;
    overflow-y: hidden !important;
    border: 0 !important;
    border-bottom: 1px solid var(--border, #dbe4e3) !important;
    border-radius: 0 !important;
    background: var(--surface, #fff) !important;
    box-sizing: border-box;
    scrollbar-width: none;
    -ms-overflow-style: none;
}

#shell .purchasing-nav::-webkit-scrollbar,
#shell .purchasing-shell-secondary-nav::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
}

#shell .purchasing-nav-group,
#shell .purchasing-shell-secondary-nav .purchasing-nav-group {
    display: flex !important;
    flex: 0 0 auto !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    align-items: stretch !important;
    justify-content: flex-start;
    gap: 3px !important;
    width: auto !important;
    min-width: max-content;
}

#shell .purchasing-nav-group-lpo {
    padding-right: 4px;
}

#shell .purchasing-nav-group-documents {
    padding-left: 2px;
}

#shell .purchasing-nav-separator {
    display: block !important;
    flex: 0 0 1px !important;
    width: 1px !important;
    min-width: 1px;
    height: 22px !important;
    align-self: center;
    margin: 0 7px !important;
    background: var(--border, #dbe4e3) !important;
}

#shell .purchasing-nav-button {
    position: relative;
    display: inline-flex !important;
    flex: 0 0 38px !important;
    align-items: center !important;
    justify-content: center !important;
    width: 38px !important;
    min-width: 38px !important;
    height: 38px !important;
    min-height: 38px !important;
    margin: 0 !important;
    padding: 0 !important;
    border: 0 !important;
    border-bottom: 3px solid transparent !important;
    border-radius: 0 !important;
    background: transparent !important;
    color: var(--muted, #64748b) !important;
    cursor: pointer;
}

#shell .purchasing-nav-button:hover {
    background: var(--surface-soft, #f8fafc) !important;
    color: var(--text, #1f2937) !important;
}

#shell .purchasing-nav-button.is-active {
    border-bottom-color: var(--brand, #0f766e) !important;
    background: transparent !important;
    color: var(--brand, #0f766e) !important;
}

#shell .purchasing-nav-icon {
    display: block !important;
    flex: 0 0 20px !important;
    width: 20px !important;
    height: 20px !important;
    margin: 0 !important;
    fill: none !important;
    stroke: currentColor !important;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
}

#shell .purchasing-nav-label {
    display: none !important;
}

.purchasing-main-content {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    align-items: stretch;
    width: 100% !important;
    max-width: none !important;
    min-width: 0;
    min-height: calc(100dvh - 190px);
}

.purchasing-view {
    flex: 1 1 auto !important;
    width: 100% !important;
    max-width: none !important;
    min-width: 0;
    min-height: calc(100dvh - 250px);
}

@media (max-width: 640px) {
    #shell .purchasing-nav,
    #shell .purchasing-shell-secondary-nav {
        padding-inline: 8px !important;
    }
    #shell .purchasing-nav-button {
        flex-basis: 36px !important;
        width: 36px !important;
        min-width: 36px !important;
        height: 38px !important;
        min-height: 38px !important;
    }
    #shell .purchasing-nav-icon {
        flex-basis: 19px !important;
        width: 19px !important;
        height: 19px !important;
    }
    .purchasing-main-content {
        min-height: calc(100dvh - 170px);
    }
    .purchasing-view {
        min-height: calc(100dvh - 230px);
    }
}

/* Purchasing LPO: compact rows, one detail per line, and a readable totals stack. */
.purchasing-catalogue-table th,
.purchasing-catalogue-table td{padding:7px 8px!important;vertical-align:top}
.purchasing-catalogue-table .purchasing-product-title{min-width:145px;line-height:1.3}
.purchasing-catalogue-table .purchasing-product-subtitle,
.purchasing-catalogue-table .purchasing-offer-price,
.purchasing-catalogue-table .purchasing-offer-basis,
.purchasing-catalogue-table .purchasing-term{display:block!important;white-space:normal;overflow-wrap:anywhere;line-height:1.3}
.purchasing-catalogue-table .purchasing-product-subtitle{margin-top:2px;font-size:10px}
.purchasing-catalogue-table .purchasing-offer-price{margin-top:2px;font-size:11px}
.purchasing-catalogue-table .purchasing-offer-basis{margin-top:2px;font-size:10px}
.purchasing-catalogue-table .purchasing-term+.purchasing-term{margin-top:3px}
.purchasing-editor-footer{align-items:flex-end;gap:16px;padding:10px 0 14px}
.purchasing-total-block{min-width:280px;gap:3px}
.purchasing-total-row{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:2px 0}
.purchasing-total-row>span{color:var(--muted,#64748b);font-size:11px;font-weight:600}
.purchasing-total-row strong{font-size:13px;letter-spacing:0;font-variant-numeric:tabular-nums}
.purchasing-total-grand{margin-top:3px;padding-top:6px;border-top:1px solid var(--border,#dbe4e3)}
.purchasing-total-grand>span{color:var(--text,#1f2937);font-weight:750}
.purchasing-total-grand strong{font-size:20px;letter-spacing:-.02em}
.purchasing-total-block small{margin-top:3px}
@media(max-width:1100px){.purchasing-editor-footer{flex-wrap:wrap}.purchasing-total-block{min-width:min(100%,280px)}.purchasing-editor-actions{flex-wrap:wrap}}

.purchasing-horizontal-lpo-v1{min-width:1600px;table-layout:fixed}
.purchasing-horizontal-lpo-v1 th,.purchasing-horizontal-lpo-v1 td{padding:7px 9px!important;vertical-align:top}
.purchasing-horizontal-lpo-v1 thead th{white-space:normal;line-height:1.3;vertical-align:bottom}
.purchasing-horizontal-lpo-v1 th:nth-child(1){width:225px}
.purchasing-horizontal-lpo-v1 th:nth-child(2){width:135px}
.purchasing-horizontal-lpo-v1 th:nth-child(3),.purchasing-horizontal-lpo-v1 th:nth-child(5){width:125px}
.purchasing-horizontal-lpo-v1 th:nth-child(4),.purchasing-horizontal-lpo-v1 th:nth-child(9){width:105px}
.purchasing-horizontal-lpo-v1 th:nth-child(6){width:175px}
.purchasing-horizontal-lpo-v1 th:nth-child(7){width:100px}
.purchasing-horizontal-lpo-v1 th:nth-child(8),.purchasing-horizontal-lpo-v1 th:nth-child(10){width:135px}
.purchasing-horizontal-lpo-v1 .purchasing-product-title{min-width:0;line-height:1.35;overflow-wrap:anywhere}
.purchasing-horizontal-lpo-v1 .purchasing-product-subtitle,.purchasing-horizontal-lpo-v1 .purchasing-offer-basis,.purchasing-horizontal-lpo-v1 .purchasing-term{display:block;margin-top:3px;white-space:normal;overflow-wrap:anywhere;line-height:1.3}
.purchasing-horizontal-lpo-v1 .purchasing-offer-price,.purchasing-horizontal-lpo-v1 .purchasing-row-total{white-space:nowrap;font-variant-numeric:tabular-nums}
.purchasing-horizontal-lpo-v1 .purchasing-quantity-input{width:88px;min-height:31px}
.purchasing-editor-footer{align-items:flex-end;gap:16px;padding:10px 0 14px}
.purchasing-total-block{min-width:290px;gap:3px}
.purchasing-total-row{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:3px 0}
.purchasing-total-row>span{color:var(--muted,#64748b);font-size:11px;font-weight:600}
.purchasing-total-row strong{font-size:13px;letter-spacing:0;font-variant-numeric:tabular-nums}
.purchasing-total-grand{margin-top:3px;padding-top:6px;border-top:1px solid var(--border,#dbe4e3)}
.purchasing-total-grand>span{color:var(--text,#1f2937);font-weight:750}
.purchasing-total-grand strong{font-size:20px;letter-spacing:-.02em}
@media(max-width:900px){.purchasing-editor-footer{flex-wrap:wrap}.purchasing-total-block{min-width:min(100%,290px)}.purchasing-editor-actions{flex-wrap:wrap}}

/* purchasing-fit-device-width-v1 */
.purchasing-page,
.purchasing-workspace,
.purchasing-view,
.purchasing-page main {
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    min-width: 0;
}

.purchasing-page {
    overflow-x: hidden;
    font-size: 10px;
}

.purchasing-page .purchasing-table-wrap {
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow-x: auto;
}

.purchasing-page .purchasing-horizontal-lpo-v1,
.purchasing-page .purchasing-catalogue-table {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    table-layout: fixed !important;
    font-size: 8px !important;
    line-height: 1.2;
}

.purchasing-page .purchasing-horizontal-lpo-v1 th,
.purchasing-page .purchasing-horizontal-lpo-v1 td,
.purchasing-page .purchasing-catalogue-table th,
.purchasing-page .purchasing-catalogue-table td {
    box-sizing: border-box;
    min-width: 0 !important;
    padding: 4px 4px !important;
    font-size: 8px !important;
    line-height: 1.2;
    white-space: normal;
    overflow-wrap: anywhere;
    word-break: normal;
    vertical-align: top;
}

.purchasing-page .purchasing-horizontal-lpo-v1 thead th,
.purchasing-page .purchasing-catalogue-table thead th {
    padding: 5px 3px !important;
    font-size: 7px !important;
    font-weight: 750;
    line-height: 1.15;
    letter-spacing: 0;
    white-space: normal;
    text-transform: uppercase;
}

.purchasing-page .purchasing-horizontal-lpo-v1 th:nth-child(1),
.purchasing-page .purchasing-catalogue-table th:nth-child(1) { width: 16% !important; }
.purchasing-page .purchasing-horizontal-lpo-v1 th:nth-child(2),
.purchasing-page .purchasing-catalogue-table th:nth-child(2) { width: 9% !important; }
.purchasing-page .purchasing-horizontal-lpo-v1 th:nth-child(3),
.purchasing-page .purchasing-catalogue-table th:nth-child(3) { width: 8% !important; }
.purchasing-page .purchasing-horizontal-lpo-v1 th:nth-child(4),
.purchasing-page .purchasing-catalogue-table th:nth-child(4) { width: 7% !important; }
.purchasing-page .purchasing-horizontal-lpo-v1 th:nth-child(5),
.purchasing-page .purchasing-catalogue-table th:nth-child(5) { width: 8% !important; }
.purchasing-page .purchasing-horizontal-lpo-v1 th:nth-child(6),
.purchasing-page .purchasing-catalogue-table th:nth-child(6) { width: 12% !important; }
.purchasing-page .purchasing-horizontal-lpo-v1 th:nth-child(7),
.purchasing-page .purchasing-catalogue-table th:nth-child(7) { width: 5% !important; }
.purchasing-page .purchasing-horizontal-lpo-v1 th:nth-child(8),
.purchasing-page .purchasing-catalogue-table th:nth-child(8) { width: 10% !important; }
.purchasing-page .purchasing-horizontal-lpo-v1 th:nth-child(9),
.purchasing-page .purchasing-catalogue-table th:nth-child(9) { width: 8% !important; }
.purchasing-page .purchasing-horizontal-lpo-v1 th:nth-child(10),
.purchasing-page .purchasing-catalogue-table th:nth-child(10) { width: 17% !important; }

.purchasing-page .purchasing-product-title {
    min-width: 0 !important;
    font-size: 8px !important;
    line-height: 1.2 !important;
    overflow-wrap: anywhere;
}

.purchasing-page .purchasing-product-subtitle,
.purchasing-page .purchasing-offer-basis,
.purchasing-page .purchasing-term,
.purchasing-page .purchasing-quantity-hint,
.purchasing-page .purchasing-row-note {
    display: block;
    max-width: 100%;
    margin-top: 2px !important;
    font-size: 7px !important;
    line-height: 1.2 !important;
    white-space: normal !important;
    overflow-wrap: anywhere;
}

.purchasing-page .purchasing-offer-price,
.purchasing-page .purchasing-row-total {
    font-size: 8px !important;
    line-height: 1.2;
    white-space: normal !important;
    overflow-wrap: anywhere;
    font-variant-numeric: tabular-nums;
}

.purchasing-page .purchasing-quantity-input {
    box-sizing: border-box;
    width: 100% !important;
    max-width: 52px;
    min-width: 0 !important;
    min-height: 25px !important;
    padding: 2px 3px !important;
    font-size: 9px !important;
}

.purchasing-page .purchasing-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
}

.purchasing-page .purchasing-field label,
.purchasing-page .purchasing-field input,
.purchasing-page .purchasing-field select {
    font-size: 9px !important;
}

.purchasing-page .purchasing-field input,
.purchasing-page .purchasing-field select {
    min-width: 0;
    min-height: 30px;
    padding: 4px 6px;
}

.purchasing-page .purchasing-section-heading h1,
.purchasing-page .purchasing-section-heading h2,
.purchasing-page .purchasing-view h2 {
    font-size: 14px;
    line-height: 1.2;
}

.purchasing-page .purchasing-editor-footer {
    flex-wrap: wrap;
    gap: 8px;
    padding: 8px 0 10px;
}

.purchasing-page .purchasing-total-block {
    min-width: 0;
    width: min(100%, 300px);
    gap: 2px;
}

.purchasing-page .purchasing-total-row {
    gap: 8px;
    padding: 2px 0;
}

.purchasing-page .purchasing-total-row > span {
    font-size: 9px !important;
}

.purchasing-page .purchasing-total-row strong {
    font-size: 10px !important;
}

.purchasing-page .purchasing-total-grand strong {
    font-size: 14px !important;
}

.purchasing-page .purchasing-editor-actions {
    flex-wrap: wrap;
    gap: 6px;
}

.purchasing-page .purchasing-editor-actions .primary-button,
.purchasing-page .purchasing-editor-actions .secondary-button {
    min-width: 100px;
    height: 32px;
    min-height: 32px;
    padding: 5px 8px;
    font-size: 9px !important;
}

@media (max-width: 900px) {
    .purchasing-page .purchasing-fields {
        grid-template-columns: minmax(0, 1fr);
    }
}

.purchasing-page {
    --purchasing-compact-workspace-v1: 1;
    box-sizing: border-box;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    margin: 0 !important;
    padding: 0 4px 3px !important;
    overflow-x: hidden;
}

.purchasing-page.purchasing-create-workspace {
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
}

.purchasing-page.purchasing-create-workspace .purchasing-workspace {
    box-sizing: border-box;
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

.purchasing-page .purchasing-page-heading {
    display: none !important;
}

.purchasing-page #purchasingStatus:empty,
.purchasing-page #purchasingStatus:not(.is-error):not(.is-success) {
    display: none !important;
