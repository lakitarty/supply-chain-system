<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../../../shared/css/base.css">
    <link rel="stylesheet" href="../../../shared/css/shell.css">
    <link rel="stylesheet" href="updates.css">
    <title>Product Updates | ChainBridge</title>
</head>
<body>
    <div id="shell"></div>

    <main class="page updates-page">
        <div class="updates-shell">
            <header class="updates-header">
                <div class="updates-heading-copy">
                    <div class="updates-eyebrow">PRODUCT INFORMATION</div>
                    <div class="updates-page-title" role="heading" aria-level="1">
                        Product updates
                    </div>
                    <p class="updates-description">
                        Track product changes shared across your supply network.
                    </p>
                </div>

                <button
                    type="button"
                    class="updates-prepare-toggle"
                    id="prepareToggleButton"
                    hidden
                    aria-expanded="false"
                    aria-controls="prepareSection">
                    Prepare a change
                </button>
            </header>

            <div id="changeMessage" class="form-message"
                 role="alert" aria-live="polite"></div>

            <section class="updates-summary" id="updatesSummary"
                     aria-label="Product update summary"></section>

            <div class="updates-toolbar">
                <div class="updates-search-wrap">
                    <label class="updates-sr-only" for="changeSearch">
                        Search product updates
                    </label>
                    <input
                        type="search"
                        id="changeSearch"
                        class="updates-search"
                        placeholder="Search products, manufacturers or barcodes">
                </div>

                <label class="updates-sr-only" for="changeStatusFilter">
                    Filter by status
                </label>
                <select id="changeStatusFilter" class="updates-filter">
                    <option value="ALL">All statuses</option>
                    <option value="PENDING_APPROVAL">Pending approval</option>
                    <option value="PUBLISHED">Published</option>
                    <option value="REJECTED">Rejected</option>
                </select>

                <label class="updates-sr-only" for="changeDirectionFilter">
                    Filter by direction
                </label>
                <select id="changeDirectionFilter" class="updates-filter">
                    <option value="ALL">All updates</option>
                    <option value="INCOMING">Received from network</option>
                    <option value="OUTGOING">Prepared by us</option>
                </select>
            </div>

            <div class="updates-workspace">
                <aside class="updates-register" aria-label="Product update register">
                    <div class="updates-register-heading">
                        <span>Update register</span>
                        <span id="changeCount" class="updates-register-count"></span>
                    </div>

                    <div id="changeList" class="updates-list"
                         role="listbox" aria-label="Product updates">
                        <p class="updates-empty">Loading product updates...</p>
                    </div>

                    <select id="changeSelect"
                            class="updates-native-select"
                            aria-label="Selected product change"></select>
                </aside>

                <section class="updates-detail-panel"
                         aria-label="Selected product update">
                    <div id="changeEmptyState" class="updates-detail-empty">
                        <div class="updates-empty-mark">↗</div>
                        <div class="updates-empty-title">
                            Select a product update
                        </div>
                        <p>
                            Choose an item from the register to review its
                            details, status and discussion.
                        </p>
                    </div>

                    <div id="changeDetailContent" hidden>
                        <header class="updates-detail-header">
                            <div class="updates-detail-heading-copy">
                                <div class="updates-detail-kicker">
                                    PRODUCT CHANGE
                                </div>
                                <div id="changeTitle" class="updates-detail-title"></div>
                                <div id="changeSubtitle" class="updates-detail-subtitle"></div>
                            </div>
                            <span id="changeStatusBadge"
                                  class="updates-status-badge"></span>
                        </header>

                        <div class="updates-detail-section">
                            <div class="updates-section-heading">
                                Change details
                            </div>
                            <dl class="detail-list" id="changeDetail"></dl>

                            <div class="updates-actions-row">
                                <div class="form-actions" id="changeActions" hidden>
                                    <button type="button"
                                            class="primary-button"
                                            id="actionButton"></button>
                                </div>
                                <p class="updates-action-note" id="actionNote"></p>
                            </div>
                        </div>

                        <section class="updates-discussion" id="threadSection" hidden>
                            <div class="updates-section-heading">
                                Discussion
                            </div>
                            <div class="thread" id="threadLog"
                                 role="log" aria-live="polite"></div>

                            <form id="messageForm" class="updates-message-form" novalidate>
                                <div class="form-group">
                                    <label for="text">Message</label>
                                    <input type="text" id="text"
                                           maxlength="2000" autocomplete="off"
                                           placeholder="Write a message about this change">
                                </div>

                                <div id="messageMessage" class="form-message"
                                     role="alert" aria-live="polite"></div>

                                <div class="form-actions">
                                    <button type="submit"
                                            class="primary-button"
                                            id="sendButton">Send message</button>
                                </div>
                            </form>
                        </section>
                    </div>
                </section>
            </div>

            <section class="updates-prepare" id="prepareSection" hidden>
                <header class="updates-prepare-header">
                    <div>
                        <div class="updates-section-heading">Prepare a change</div>
                        <p class="updates-description">
                            Submit updated product information for approval.
                        </p>
                    </div>
                    <span class="updates-form-context">MANUFACTURER WORKFLOW</span>
                </header>

                <form id="prepareForm" novalidate>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="productId">Product</label>
                            <select id="productId"></select>
                        </div>

                        <div class="form-group">
                            <label for="changeType">Change type</label>
                            <select id="changeType">
                                <option value="BARCODE_CHANGE">Barcode change</option>
                                <option value="PACKAGING_CHANGE">Packaging change</option>
                                <option value="PRODUCT_INFORMATION_CHANGE">
                                    Product information change
                                </option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="barcode">New barcode</label>
                            <input type="text" id="barcode" maxlength="14"
                                   inputmode="numeric">
                        </div>

                        <div class="form-group">
                            <label for="packSize">
                                New pack size <span class="optional">(optional)</span>
                            </label>
                            <input type="text" id="packSize" maxlength="100">
                        </div>

                        <div class="form-group">
                            <label for="packaging">
                                New packaging <span class="optional">(optional)</span>
                            </label>
                            <input type="text" id="packaging" maxlength="255">
                        </div>

                        <div class="form-group">
                            <label for="effectiveDate">Effective date</label>
                            <input type="date" id="effectiveDate">
                        </div>

                        <div class="form-group">
                            <label for="reason">Reason</label>
                            <input type="text" id="reason" maxlength="1000">
                        </div>
                    </div>

                    <div id="formMessage" class="form-message"
                         role="alert" aria-live="polite"></div>

                    <div class="form-actions">
                        <button type="submit" class="primary-button"
                                id="saveButton">Submit for approval</button>
                    </div>
                </form>
            </section>
        </div>
    </main>

    <script src="../../../shared/js/api.js"></script>
    <script src="../../../shared/js/form-helpers.js"></script>
    <script src="../../../shared/js/navigation.js"></script>
    <script src="../../../shared/js/shell.js"></script>
    <script src="../../../shared/js/page-router.js"></script>
    <script src="updates.js"></script>
</body>
</html>