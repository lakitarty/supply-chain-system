.product-management-page {
    width: min(100% - 64px, 1180px);
    margin: 0 auto;
    padding: 24px 0 44px;
    color: #18232b;
}

.product-page-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 20px;
}

.product-breadcrumb {
    margin-bottom: 7px;
    color: #52616a;
    font-size: 11px;
}

.product-management-page > .product-page-heading .page-title {
    margin: 0;
    color: #17262b;
    font-size: 25px;
    font-weight: 650;
    letter-spacing: -0.4px;
}

.product-selector {
    display: grid;
    grid-template-columns: auto minmax(230px, 300px);
    align-items: center;
    gap: 12px;
}

.product-selector label {
    color: #293941;
    font-size: 12px;
    font-weight: 600;
}

.product-selector select {
    height: 36px;
    padding: 0 10px;
    border: 1px solid #b9c4c8;
    border-radius: 3px;
    background: #ffffff;
    color: #17262b;
    font-family: inherit;
    font-size: 12px;
}

/* Object header */

.product-object-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 100px;
    padding: 18px 22px;
    border: 1px solid #d8dfe1;
    border-bottom: 0;
    background: #ffffff;
}

.object-header-eyebrow {
    margin-bottom: 5px;
    color: #52616a;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
}

.product-object-header h2 {
    margin: 0;
    color: #17262b;
    font-size: 22px;
    font-weight: 650;
    letter-spacing: -0.3px;
}

.product-object-header p {
    margin: 6px 0 0;
    color: #52616a;
    font-size: 12px;
}

/* Fiori-style section anchor bar */

.product-object-nav {
    position: relative;
    display: flex;
    align-items: stretch;
    gap: 0;
    min-height: 43px;
    padding: 0 15px;
    border: 1px solid #d8dfe1;
    background: #ffffff;
}

.product-object-nav a {
    display: flex;
    align-items: center;
    min-height: 43px;
    margin-right: 24px;
    padding: 0 5px;
    border-bottom: 3px solid transparent;
    color: #34454d;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
}

.product-object-nav a:hover {
    color: #8B3D68;
}

.product-object-nav a.active {
    border-bottom-color: #8B3D68;
    color: #8B3D68;
}

/* Object page sections */

.object-section {
    padding: 22px 22px 24px;
    border: 1px solid #d8dfe1;
    border-top: 0;
    background: #ffffff;
    scroll-margin-top: 20px;
}

.object-section + .object-section {
    border-top: 1px solid #e0e5e7;
}

.object-section-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 19px;
}

.object-section-heading h3 {
    margin: 0;
    color: #17262b;
    font-size: 16px;
    font-weight: 650;
}

.object-section-heading p {
    margin: 5px 0 0;
    color: #52616a;
    font-size: 11px;
}

/* General information */

.general-information-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 230px;
    align-items: start;
    gap: 35px;
}

.general-information-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 26px;
}

.product-image-panel {
    padding-left: 20px;
    border-left: 1px solid #e0e5e7;
}

.product-image-heading {
    margin-bottom: 13px;
    color: #293941;
    font-size: 12px;
    font-weight: 650;
}

.product-image-panel .image-upload-label {
    display: block;
    margin-bottom: 7px;
    color: #293941;
    font-size: 12px;
    font-weight: 600;
}

.product-image-panel .image-upload-label span {
    color: #52616a;
    font-weight: 400;
}

.product-management-page #productImage {
    width: 100%;
    min-width: 0;
    padding: 5px;
    border: 1px solid #bac5c8;
    border-radius: 3px;
    background: #ffffff;
    color: #293941;
    font-family: inherit;
    font-size: 10px;
}

.product-management-page #productImage::file-selector-button {
    margin-right: 7px;
    padding: 6px 8px;
    border: 0;
    border-radius: 2px;
    background: #edf1f2;
    color: #273840;
    font: inherit;
    cursor: pointer;
}

.product-management-page #imagePreviewContainer:not([hidden]) {
    margin-bottom: 12px;
}

.product-management-page #imagePreviewLabel {
    margin: 0 0 7px;
    color: #52616a;
    font-size: 11px;
}

.product-management-page #imagePreview {
    display: block;
    width: 100%;
    max-width: 185px;
    height: 125px;
    object-fit: contain;
    border: 1px solid #e1e5e7;
    border-radius: 3px;
    background: #ffffff;
}

/* Fiori form field alignment */

.object-field-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 35px;
}

.product-management-page .form-group {
    display: grid;
    grid-template-columns: minmax(130px, 165px) minmax(0, 1fr);
    align-items: center;
    column-gap: 14px;
    min-width: 0;
}

.product-management-page .form-group > label {
    color: #293941;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.45;
}

.product-management-page .form-group input,
.product-management-page .form-group select,
.product-management-page .form-group textarea,
.product-management-page .product-selector select {
    width: 100%;
    min-width: 0;
    border: 1px solid #bac5c8;
    border-radius: 3px;
    background: #ffffff;
    color: #17262b;
    font-family: inherit;
    font-size: 12px;
    transition: border-color 120ms ease, box-shadow 120ms ease;
}

.product-management-page .form-group input,
.product-management-page .form-group select {
    height: 36px;
    padding: 0 9px;
}

.product-management-page .form-group textarea {
    min-height: 88px;
    padding: 9px;
    resize: vertical;
    line-height: 1.5;
}

.product-management-page .form-group input:focus,
.product-management-page .form-group select:focus,
.product-management-page .form-group textarea:focus,
.product-selector select:focus {
    border-color: #8B3D68;
    outline: none;
    box-shadow: 0 0 0 2px rgba(139, 61, 104, 0.12);
}

.product-management-page .form-group input::placeholder,
.product-management-page .form-group textarea::placeholder {
    color: #52616a;
    opacity: 1;
}

.product-management-page .field-hint {
    grid-column: 2;
    margin: 4px 0 0;
    color: #52616a;
    font-size: 10px;
    line-height: 1.4;
}

/* Description */

.description-field {
    display: grid;
    grid-template-columns: 165px minmax(0, 1fr);
    align-items: start;
    gap: 14px;
}

.description-field label {
    padding-top: 9px;
    color: #293941;
    font-size: 12px;
    font-weight: 600;
}

.description-field textarea {
    width: 100%;
    min-height: 88px;
    padding: 9px;
    border: 1px solid #bac5c8;
    border-radius: 3px;
    color: #17262b;
    font-family: inherit;
    font-size: 12px;
    resize: vertical;
}

/* Footer action bar */

.product-management-page #productMessage {
    margin: 12px 0;
}

.product-action-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 54px;
    padding: 8px 18px;
    border: 1px solid #d8dfe1;
    border-top: 0;
    background: #f7f8f8;
}

.action-context {
    color: #52616a;
    font-size: 11px;
}

.product-management-page .form-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
}

.product-management-page .form-actions .primary-button {
    min-width: 120px;
    height: 34px;
    padding: 0 15px;
    border: 1px solid #0f766e;
    border-radius: 3px;
    background: #0f766e;
    color: #ffffff;
    font-family: inherit;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
}

.product-management-page .form-actions .primary-button:hover {
    border-color: #115e59;
    background: #115e59;
}

.product-management-page #cancelEditButton {
    min-height: 34px;
    padding: 0 13px;
    border: 1px solid #89979d;
    border-radius: 3px;
    background: #ffffff;
    color: #293941;
    font-family: inherit;
    font-size: 12px;
    cursor: pointer;
}

.product-management-page #cancelEditButton:hover {
    background: #edf1f2;
}

.product-management-page button:focus-visible {
    outline: 2px solid #8B3D68;
    outline-offset: 2px;
}

.product-management-page button:disabled {
    cursor: not-allowed;
    opacity: 0.65;
}

.product-management-page [hidden] {
    display: none !important;
}