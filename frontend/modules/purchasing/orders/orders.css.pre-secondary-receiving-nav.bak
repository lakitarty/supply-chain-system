.purchasing-page #createView .purchasing-total-row strong {
    font-size: 11px !important;
}

.purchasing-page #createView .purchasing-total-grand strong {
    font-size: 15px !important;
}

.purchasing-page #createView .purchasing-editor-actions .primary-button,
.purchasing-page #createView .purchasing-editor-actions .secondary-button {
    min-height: 31px !important;
    height: 31px !important;
    font-size: 10px !important;
}
/* ChainBridge directional purchasing workflow */
.purchasing-nav-group-documents[hidden],.purchasing-nav-button[hidden]{display:none!important}
.purchasing-status-badge.status-rejected{background:#fee2e2;color:#991b1b}

/* CHAINBRIDGE LPO PRINT LAYOUT START */
#lpoPrintRoot {
    display: none;
}

@media print {
    @page {
        size: A4 portrait;
        margin: 0;
    }

    html,
    body {
        width: 210mm !important;
        margin: 0 !important;
        padding: 0 !important;
        background: #fff !important;
    }

    body.lpo-print-active > :not(#lpoPrintRoot) {
        display: none !important;
    }

    body.lpo-print-active > #lpoPrintRoot {
        display: block !important;
        width: 210mm !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    #lpoPrintRoot .lpo-print-page {
        position: relative;
        display: block;
        width: 210mm;
        height: 297mm;
        margin: 0;
        padding: 7mm 7mm 6mm;
        overflow: hidden;
        box-sizing: border-box;
        background: #fff;
        color: #111;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 8pt;
        page-break-after: always;
        break-after: page;
    }

    #lpoPrintRoot .lpo-print-page:last-child {
        page-break-after: auto;
        break-after: auto;
    }

    #lpoPrintRoot .lpo-print-page * {
        box-sizing: border-box;
    }

    #lpoPrintRoot .lpo-print-header {
        text-align: center;
        margin: 0 0 4mm;
    }

    #lpoPrintRoot .lpo-print-header h1 {
        margin: 0 0 1mm;
        font-size: 14pt;
        line-height: 1.15;
        font-weight: 700;
    }

    #lpoPrintRoot .lpo-print-header p {
        margin: 0 0 2mm;
        font-size: 8pt;
    }

    #lpoPrintRoot .lpo-print-header h2 {
        margin: 0;
        font-size: 10pt;
        line-height: 1.2;
        font-weight: 700;
    }

    #lpoPrintRoot .lpo-supplier-section {
        display: grid;
        grid-template-columns: 1fr 66mm;
        gap: 5mm;
        min-height: 22mm;
        margin-bottom: 2mm;
    }

    #lpoPrintRoot .lpo-supplier p {
        margin: 0 0 3mm;
        line-height: 1.25;
    }

    #lpoPrintRoot .lpo-print-meta {
        display: grid;
        grid-template-columns: 22mm 1fr;
        align-content: start;
        row-gap: 1.5mm;
        font-size: 7.5pt;
    }

    #lpoPrintRoot .lpo-print-meta div {
        display: contents;
    }

    #lpoPrintRoot .lpo-print-meta strong,
    #lpoPrintRoot .lpo-print-meta span {
        min-width: 0;
        padding-bottom: 0.5mm;
    }

    #lpoPrintRoot .lpo-item-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        font-size: 7.2pt;
    }

    #lpoPrintRoot .lpo-item-table th,
    #lpoPrintRoot .lpo-item-table td {
        border: 0.25mm solid #222;
        padding: 0.55mm 0.7mm;
        height: 4.7mm;
        line-height: 1.1;
        vertical-align: middle;
        text-align: left;
        overflow-wrap: anywhere;
    }

    #lpoPrintRoot .lpo-item-table th {
        font-weight: 700;
        text-align: center;
    }

    #lpoPrintRoot .lpo-item-table td:nth-child(1),
    #lpoPrintRoot .lpo-item-table td:nth-child(5),
    #lpoPrintRoot .lpo-item-table td:nth-child(6),
    #lpoPrintRoot .lpo-item-table td:nth-child(7) {
        text-align: center;
    }

    #lpoPrintRoot .lpo-print-footer {
        position: absolute;
        left: 7mm;
        right: 7mm;
        bottom: 6mm;
        font-size: 7.2pt;
    }

    #lpoPrintRoot .lpo-terms-row {
        display: grid;
        grid-template-columns: 15mm 1fr 36mm;
        column-gap: 2mm;
        align-items: center;
        min-height: 7mm;
        border-bottom: 0.25mm solid #222;
        margin-bottom: 2mm;
    }

    #lpoPrintRoot .lpo-terms-line {
        height: 4mm;
        border-bottom: 0.25mm solid #777;
    }

    #lpoPrintRoot .lpo-approval-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 4mm;
        min-height: 24mm;
        margin-bottom: 2mm;
    }

    #lpoPrintRoot .lpo-approval-grid > div {
        display: flex;
        flex-direction: column;
        gap: 1.2mm;
        min-width: 0;
    }

    #lpoPrintRoot .lpo-signature-name {
        min-height: 4mm;
        overflow-wrap: anywhere;
    }

    #lpoPrintRoot .lpo-goods-heading {
        border-top: 0.35mm solid #222;
        border-bottom: 0.25mm solid #222;
        padding: 1.5mm 0;
        text-align: center;
        font-weight: 700;
    }

    #lpoPrintRoot .lpo-goods-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2mm 5mm;
        padding: 2mm 0 3mm;
    }

    #lpoPrintRoot .lpo-printed-line {
        display: flex;
        justify-content: space-between;
        gap: 4mm;
        border-top: 0.25mm solid #222;
        padding-top: 2mm;
        font-size: 6.8pt;
    }

    #lpoPrintRoot .lpo-empty-row td {
        color: transparent;
    }
}
/* CHAINBRIDGE LPO PRINT LAYOUT END */

/* CHAINBRIDGE LPO HEADER VISIBILITY FIX */
@media print {
    #lpoPrintRoot .lpo-print-header,
    #lpoPrintRoot .lpo-print-header h1,
    #lpoPrintRoot .lpo-print-header h2,
    #lpoPrintRoot .lpo-print-header p {
        display: block !important;
        visibility: visible !important;
        opacity: 1 !important;
        color: #111111 !important;
        -webkit-text-fill-color: #111111 !important;
        background: transparent !important;
        text-indent: 0 !important;
    }

    #lpoPrintRoot .lpo-print-header h1 {
        font-size: 14pt !important;
        font-weight: 700 !important;
        line-height: 1.2 !important;
        margin: 0 0 1mm !important;
        text-align: center !important;
    }

    #lpoPrintRoot .lpo-print-header h2 {
        font-size: 10pt !important;
        font-weight: 700 !important;
        line-height: 1.2 !important;
        margin: 0 !important;
        text-align: center !important;
    }

    #lpoPrintRoot .lpo-print-header p {
        font-size: 8pt !important;
        margin: 0 0 2mm !important;
        text-align: center !important;
    }
}
/* END CHAINBRIDGE LPO HEADER VISIBILITY FIX */

/* CHAINBRIDGE LPO NUMBER POSITIONING AND VALIDITY */
@media print {
    #lpoPrintRoot .lpo-print-header {
        position: relative !important;
        display: block !important;
        min-height: 23mm !important;
        margin: 0 0 4mm !important;
        padding: 0 !important;
        text-align: center !important;
        overflow: visible !important;
    }

    #lpoPrintRoot .lpo-header-issuer {
        width: 100% !important;
        padding: 0 46mm 0 0 !important;
        box-sizing: border-box !important;
        text-align: center !important;
    }

    #lpoPrintRoot .lpo-header-issuer h1 {
        margin: 0 0 1mm !important;
        font-size: 14pt !important;
        font-weight: 700 !important;
        color: #111 !important;
        text-align: center !important;
    }

    #lpoPrintRoot .lpo-header-issuer p {
        margin: 0 0 2mm !important;
        font-size: 8pt !important;
        color: #111 !important;
        text-align: center !important;
    }

    #lpoPrintRoot .lpo-header-issuer h2 {
        margin: 0 !important;
        font-size: 10pt !important;
        font-weight: 700 !important;
        color: #111 !important;
        text-align: center !important;
    }

    #lpoPrintRoot .lpo-header-number {
        position: absolute !important;
        top: 0 !important;
        right: 0 !important;
        width: 44mm !important;
        display: flex !important;
        flex-direction: column !important;
        gap: 1mm !important;
        text-align: right !important;
        font-size: 7.2pt !important;
        color: #111 !important;
    }

    #lpoPrintRoot .lpo-header-number span {
        font-size: 9pt !important;
        font-weight: 700 !important;
    }

    #lpoPrintRoot .lpo-supplier p {
        margin: 0 0 1.3mm !important;
        color: #111 !important;
        font-size: 8pt !important;
        overflow-wrap: anywhere !important;
    }

    #lpoPrintRoot .lpo-print-meta {
        font-size: 7.5pt !important;
    }

    #lpoPrintRoot .lpo-print-meta div {
        display: grid !important;
        grid-template-columns: 22mm 1fr !important;
        column-gap: 1mm !important;
    }

    #lpoPrintRoot .lpo-print-meta strong,
    #lpoPrintRoot .lpo-print-meta span {
        color: #111 !important;
    }

    #lpoPrintRoot .lpo-approval-date-row,
    #lpoPrintRoot .lpo-signature-row {
        display: grid !important;
        grid-template-columns: repeat(3, 1fr) !important;
        gap: 4mm !important;
        margin-bottom: 1.5mm !important;
        font-size: 7pt !important;
    }
}
/* END CHAINBRIDGE LPO NUMBER POSITIONING AND VALIDITY */

