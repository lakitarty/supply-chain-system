@font-face {
    font-family: "Manrope";
    src: url("../fonts/Manrope.ttf") format("truetype");
    font-weight: 400 900;
    font-style: normal;
    font-display: swap;
}
.shell-main-row {
    display: flex;
    align-items: stretch;
    gap: var(--space-xl);
    min-height: 48px;
    padding-inline: var(--gutter);
    background:#104e5cd2;
    color: var(--white);
}

.shell-brand {
    display: flex;
    align-items: center;
    font-family: "Manrope", "Arial", sans-serif;
    font-size: var(--text-large);
    font-weight: 600;
    letter-spacing: 0.3px;
    color: var(--white);
    white-space: nowrap;
}

.shell-tabs {
    display: flex;
    align-items: stretch;
    flex: 1;
}

.shell-tab {
    display: flex;
    align-items: center;
    padding: 0 14px;
    border-bottom: 3px solid transparent;
    color: rgba(255, 255, 255, 0.82);
    font-size: var(--text-base);
    text-decoration: none;
    white-space: nowrap;
}

a.shell-tab:hover {
    background: rgba(255, 255, 255, 0.1);
    color: var(--white);
}

.shell-tab.active {
    border-bottom-color: var(--white);
    color: var(--white);
    font-weight: 600;
}

.shell-tab.disabled {
    color: rgba(255, 255, 255, 0.4);
    cursor: default;
}

.shell-user {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--space-m);
    white-space: nowrap;
}

.shell-user-text {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1.3;
}

.shell-user-name {
    font-size: var(--text-label);
    font-weight: 600;
}

.shell-user-meta {
    font-size: var(--text-small);
    color: rgba(255, 255, 255, 0.75);
}

.shell-signout {
    height: 30px;
    padding: 0 12px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: var(--radius);
    background: transparent;
    color: var(--white);
    font-size: var(--text-label);
    cursor: pointer;
}

.shell-signout:hover {
    background: rgba(255, 255, 255, 0.12);
}

.shell-sections {
    display: flex;
    gap: 4px;
    min-height: 38px;
    padding-inline: var(--gutter);
    background: var(--white);
    border-bottom: 1px solid var(--border-light);
}

.shell-sections:empty {
    display: none;
}

.shell-section {
    display: flex;
    align-items: center;
    padding: 0 12px;
    border-bottom: 2px solid transparent;
    color: var(--muted);
    font-size: var(--text-label);
    text-decoration: none;
}

a.shell-section:hover {
    color: #8B3D68;
}

.shell-section.active {
    border-bottom-color: #8B3D68;
    color: #8B3D68;
    font-weight: 600;
}

.shell-section.disabled {
    color: var(--disabled);
    cursor: default;
}

.page {
    padding: 20px var(--gutter) 28px;
}


body:has(#recordForm) #recordForm {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 24px;
}

body:has(#recordForm) #recordForm .form-group {
    margin-bottom: 12px;
}

body:has(#recordForm) .page,
body:has(#profileForm) .page {
    max-width: 808px;
}

body:has(#shell):not(.shell-ready) .page {
    visibility: hidden;
}
.page-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-l);
}
.page-title {
    margin: 0;
    font-size: var(--text-title);
    font-weight: 600;
}

.page-description {
    margin: 2px 0 0;
    color: var(--muted);
    font-size: var(--text-label);
}

.page-section {
    margin-top: 16px;
}

.section-title {
    margin: 0 0 var(--space-m);
    padding-bottom: var(--space-s);
    border-bottom: 1px solid var(--border-light);
    font-size: var(--text-base);
    font-weight: 600;
}

.thread {
    max-height: 280px;
    margin-bottom: var(--space-m);
    padding: var(--space-m);
    overflow-y: auto;
    border: 1px solid var(--border-light);
    border-radius: var(--radius);
    background: var(--white);
}

.thread:empty::before {
    content: "No messages yet. Start the discussion below.";
    color: var(--muted);
    font-size: var(--text-label);
}

.message-line {
    margin-bottom: var(--space-m);
}

.message-meta {
    display: block;
    color: var(--muted);
    font-size: var(--text-small);
}

.record-bar {
    max-width: 640px;
    margin-bottom: var(--space-m);
}

.detail-list {
    display: grid;
    grid-template-columns: 140px 1fr;
    margin: 0;
}

.detail-list dt,
.detail-list dd {
    margin: 0;
    padding: 8px 0;
    border-bottom: 1px solid var(--border-light);
}

.detail-list dt {
    color: var(--muted);
}

.desktop-notice {
    display: none;
    padding: 64px 24px;
    text-align: center;
    font-size: var(--text-large);
    line-height: 1.5;
}

@media (max-width: 899px) {
    .shell,
    .page {
        display: none;
    }

    .desktop-notice {
        display: block;
    }
}




.shell-refresh {
    height: 30px;
    padding: 0 12px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.08);
    color: var(--white);
    font-size: var(--text-label);
    cursor: pointer;
    white-space: nowrap;
}

.shell-refresh:hover {
    background: rgba(255, 255, 255, 0.18);
}

.shell-refresh:focus-visible {
    outline: 2px solid var(--white);
    outline-offset: 2px;
}



.shell-main-row {
    gap: clamp(8px, 1vw, var(--space-xl));
}

.shell-brand {
    display: flex;
    align-items: center;
    font-family: "Manrope", "Arial", sans-serif;
    font-size: var(--text-large);
    font-weight: 600;
    letter-spacing: 0.3px;
    color: var(--white);
    white-space: nowrap;
}

.shell-tabs {
    min-width: 0;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: thin;
}

.shell-tab {
    flex-shrink: 0;
}

.shell-user {
    flex-shrink: 0;
    margin-left: auto;
    gap: var(--space-s);
}

.shell-user-text {
    min-width: 0;
    max-width: 220px;
}

.shell-user-meta {
    max-width: 220px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.shell-refresh,
.shell-signout {
    flex-shrink: 0;
}



.shell-main-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-width: 0;
    min-height: 58px;
    padding: 10px var(--gutter);
    background: #104e5c;
    color: var(--white);
}

.shell-brand {
    display: flex;
    align-items: center;
    font-family: "Manrope", "Arial", sans-serif;
    font-size: var(--text-large);
    font-weight: 600;
    letter-spacing: 0.3px;
    color: var(--white);
    white-space: nowrap;
}

.shell-user {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex: 0 1 auto;
    min-width: 0;
    gap: 10px;
}

.shell-user-text {
    flex: 0 1 auto;
    min-width: 0;
    max-width: 300px;
}

.shell-user-name,
.shell-user-meta {
    max-width: 100%;
    overflow-wrap: anywhere;
}

.shell-user-meta {
    line-height: 1.4;
}

.shell-refresh,
.shell-signout {
    flex: 0 0 auto;
}

.shell-primary-row {
    min-width: 0;
    padding: 0 var(--gutter);
    background: #0b3f4a;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
}

.shell-primary-row .shell-tabs {
    display: flex;
    align-items: stretch;
    min-width: 0;
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: thin;
}

.shell-primary-row .shell-tab {
    flex: 0 0 auto;
    min-height: 43px;
    padding: 0 16px;
}

.shell-primary-row .shell-tab.active {
    border-bottom-color: #ffffff;
    background: rgba(255, 255, 255, 0.09);
}

.shell-sections {
    min-width: 0;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: thin;
}

.shell-section {
    flex: 0 0 auto;
    min-height: 38px;
    white-space: nowrap;
}

@media (max-width: 1100px) {
    .shell-main-row {
        gap: 12px;
    }

    .shell-user-text {
        max-width: 220px;
    }

    .shell-primary-row .shell-tab {
        padding-inline: 12px;
    }
}

@media (max-width: 899px) {
    .shell-main-row {
        align-items: flex-start;
        flex-wrap: wrap;
    }

    .shell-user {
        max-width: 100%;
        flex-wrap: wrap;
    }

    .shell-user-text {
        max-width: 100%;
    }
}



.shell-primary-row .shell-tabs,
.shell-sections {
    scrollbar-width: none;
    -ms-overflow-style: none;
}

.shell-primary-row .shell-tabs::-webkit-scrollbar,
.shell-sections::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
}



.shell-primary-row {
    overflow: hidden;
}

.shell-primary-row .shell-tabs {
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none !important;
    -ms-overflow-style: none !important;
}

.shell-primary-row .shell-tabs::-webkit-scrollbar,
.shell-primary-row .shell-tabs::-webkit-scrollbar-track,
.shell-primary-row .shell-tabs::-webkit-scrollbar-thumb {
    display: none !important;
    width: 0 !important;
    height: 0 !important;
    background: transparent !important;
}



html {
    height: 100%;
}

body.shell-ready {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    min-height: 0;
    overflow: hidden;
}

body.shell-ready #shell {
    flex: 0 0 auto;
    min-width: 0;
}

body.shell-ready #shell .shell {
    flex: 0 0 auto;
    min-width: 0;
}

body.shell-ready .page {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 0;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior-y: contain;
    scrollbar-gutter: stable;
}

body.shell-ready > .desktop-notice {
    display: none;
}



body.shell-ready .page {
    scrollbar-width: none;
    -ms-overflow-style: none;
}

body.shell-ready .page::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
}



.shell-organization-profile {
    display: inline-flex;
    flex: 0 0 34px;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.65);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    color: var(--white);
    text-decoration: none;
    cursor: pointer;
}

.shell-organization-profile:hover {
    border-color: var(--white);
    background: rgba(255, 255, 255, 0.22);
}

.shell-organization-profile:focus-visible {
    outline: 2px solid var(--white);
    outline-offset: 3px;
}

.shell-organization-avatar-image {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
}

.shell-organization-avatar-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 2px;
    color: var(--white);
    font-size: 11px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.2px;
    text-align: center;
    overflow-wrap: anywhere;
}

/* Branch profile tab with organisation logo */
.shell-primary-row .shell-tab-profile {
    margin-left: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.shell-profile-tab-avatar {
    display: inline-flex;
    flex: 0 0 28px;
    width: 28px;
    height: 28px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
}

.shell-profile-tab-avatar-image {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
}

.shell-profile-tab-avatar-fallback {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-size: 10px;
    font-weight: 600;
}

.shell-tab-profile-label {
    white-space: nowrap;
}
/* Fixed Nexora session footer */
/* Fixed Nexora session footer */
.shell-status-footer {
    position: relative;
    flex: 0 0 auto;
    width: 100%;
    box-sizing: border-box;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 40px;
    padding: 7px var(--gutter);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    background: #0b3f4a;
    color: rgba(255, 255, 255, 0.9);
    font-size: var(--text-small);
    box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.08);
    box-sizing: border-box;
}

.shell-status-identity {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
}

.shell-status-indicator {
    flex: 0 0 7px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #69d6a0;
}

.shell-status-label {
    color: rgba(255, 255, 255, 0.7);
    white-space: nowrap;
}

.shell-status-details {
    overflow: hidden;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.shell-status-system {
    flex: 0 0 auto;
    color: rgba(255, 255, 255, 0.65);
    white-space: nowrap;
}

body.shell-ready .page {
    padding-bottom: 0;
}

@media (max-width: 600px) {
    .shell-status-system {
        display: none;
    }

    .shell-status-identity {
        gap: 6px;
    }
}

/* ChainBridge compact fixed-height workspace v2 */
/* Keep the navigation and session footer compact; the main page owns only the space between them. */
body.shell-ready {
    display: flex !important;
    flex-direction: column !important;
    width: 100% !important;
    height: 100vh !important;
    height: 100dvh !important;
    min-height: 0 !important;
    max-height: 100dvh !important;
    overflow: hidden !important;
}

body.shell-ready > #shell {
    flex: 0 0 auto !important;
    width: 100% !important;
    min-width: 0 !important;
}

body.shell-ready > #shell > .shell {
    display: flex !important;
    flex-direction: column !important;
    flex: 0 0 auto !important;
    width: 100% !important;
    min-width: 0 !important;
}

body.shell-ready #shell .shell-main-row {
    flex: 0 0 auto !important;
    min-height: 40px !important;
    height: auto !important;
    padding-block: 3px !important;
    gap: 10px !important;
    align-items: center !important;
    box-sizing: border-box !important;
}

body.shell-ready #shell .shell-brand {
    font-size: 16px !important;
    line-height: 1.1 !important;
}

body.shell-ready #shell .shell-user {
    gap: 8px !important;
}

body.shell-ready #shell .shell-user-name {
    font-size: 12px !important;
    line-height: 1.1 !important;
}

body.shell-ready #shell .shell-user-meta {
    font-size: 10px !important;
    line-height: 1.1 !important;
}

body.shell-ready #shell .shell-signout,
body.shell-ready #shell .shell-refresh {
    height: 26px !important;
    padding-inline: 9px !important;
    font-size: 11px !important;
}

body.shell-ready #shell .shell-primary-row {
    flex: 0 0 auto !important;
    min-height: 0 !important;
    padding-block: 0 !important;
}

body.shell-ready #shell .shell-primary-row .shell-tab {
    flex: 0 0 auto !important;
    min-height: 34px !important;
    padding-inline: 11px !important;
    border-bottom-width: 2px !important;
    font-size: 12px !important;
    line-height: 1.1 !important;
}

body.shell-ready #shell .shell-sections {
    flex: 0 0 auto !important;
    min-height: 28px !important;
    height: auto !important;
    padding-block: 0 !important;
    gap: 2px !important;
}

body.shell-ready #shell .shell-sections .shell-section {
    flex: 0 0 auto !important;
    min-height: 28px !important;
    height: auto !important;
    padding-inline: 9px !important;
    font-size: 11px !important;
    line-height: 1.1 !important;
}

/* The page is a flex viewport. Its children scroll inside this box, never underneath the footer. */
body.shell-ready > main.page,
body.shell-ready > .page {
    flex: 1 1 0px !important;
    height: 0 !important;
    min-height: 0 !important;
    max-height: none !important;
    min-width: 0 !important;
    max-width: 100% !important;
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    overflow-x: hidden !important;
    overflow-y: auto !important;
    overscroll-behavior: contain !important;
    box-sizing: border-box !important;
}

body.shell-ready > .shell-status-footer {
    position: relative !important;
    inset: auto !important;
    flex: 0 0 auto !important;
    align-self: stretch !important;
    width: 100% !important;
    height: auto !important;
    min-height: 34px !important;
    max-height: none !important;
    margin: 0 !important;
    padding: 2px var(--gutter) !important;
    box-sizing: border-box !important;
    line-height: 1.1 !important;
}

body.shell-ready > .shell-status-footer .shell-status-details {
    max-width: 70vw;
    font-size: 11px !important;
    line-height: 1.15 !important;
}

body.shell-ready > .shell-status-footer .shell-status-date {
    font-size: 9px !important;
    line-height: 1.05 !important;
}

body.shell-ready > .shell-status-footer .shell-status-clock {
    font-size: 12px !important;
    line-height: 1.1 !important;
}




/* Bridge brand accent */
body.shell-ready #shell .shell-brand {
    color: #F4A340 !important;
}

/* Final Bridge header sizing and branding */
body.shell-ready #shell .shell-brand {
    color: #ffffff !important;
}

.shell-main-row {
    height: 48px !important;
    min-height: 48px !important;
    padding-block: 0 !important;
    box-sizing: border-box !important;
    align-items: center !important;
}

.shell-main-row #chainbridge-window-controls {
    height: 32px !important;
    align-self: center !important;
}

.shell-main-row .chainbridge-window-button {
    height: 32px !important;
    flex-basis: 42px !important;
}

/* Integrated primary navigation in the compact desktop title bar */
body.shell-ready #shell .shell-main-row {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    height: 36px !important;
    min-height: 36px !important;
    max-height: 36px !important;
    padding: 0 !important;
    gap: 0 !important;
    overflow: hidden !important;
    box-sizing: border-box !important;
}

body.shell-ready #shell .shell-main-row .shell-tabs {
    display: flex !important;
    flex: 1 1 auto !important;
    align-items: stretch !important;
    min-width: 0 !important;
    width: auto !important;
    height: 36px !important;
    overflow-x: auto !important;
    overflow-y: hidden !important;
    scrollbar-width: none !important;
}

body.shell-ready #shell .shell-main-row .shell-tabs::-webkit-scrollbar {
    display: none !important;
}

body.shell-ready #shell .shell-main-row .shell-tab {
    display: flex !important;
    flex: 0 0 auto !important;
    align-items: center !important;
    min-height: 36px !important;
    height: 36px !important;
    padding: 0 11px !important;
    border-bottom: 2px solid transparent !important;
    color: rgba(255, 255, 255, 0.85) !important;
    font-size: 12px !important;
    line-height: 1 !important;
    white-space: nowrap !important;
}

body.shell-ready #shell .shell-main-row .shell-tab.active {
    border-bottom-color: #ffffff !important;
    background: rgba(255, 255, 255, 0.09) !important;
    color: #ffffff !important;
}

body.shell-ready #shell .shell-main-row .shell-tab:hover {
    background: rgba(255, 255, 255, 0.1) !important;
    color: #ffffff !important;
}

/* Keep the secondary navigation compact underneath */
body.shell-ready #shell .shell-sections {
    min-height: 28px !important;
    height: 28px !important;
}
/* Footer price protection status */
body.shell-ready > .shell-status-footer .shell-status-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 22px;
    flex: 0 0 auto;
}

body.shell-ready > .shell-status-footer .shell-price-protection {
    color: #F59E0B;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.04em;
    white-space: nowrap;
}
