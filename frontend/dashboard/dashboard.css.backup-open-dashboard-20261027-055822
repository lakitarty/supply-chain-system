    .dashboard-activity-list {
        padding-bottom: 48px;
        scroll-padding-bottom: 48px;
    }
}

/* Keep dashboard content above the fixed application footer */
body:has(.dashboard-page) > .dashboard-page {
    box-sizing: border-box;
    padding-bottom: 40px !important;
    margin-bottom: 0 !important;
    min-height: 0 !important;
    overflow: hidden !important;
}

.dashboard-page > #dashboardCardGrid {
    min-height: 0 !important;
    margin-bottom: 0 !important;
    padding-bottom: 0 !important;
    overflow: hidden !important;
}

.dashboard-command-center,
.dashboard-command-workspace {
    box-sizing: border-box;
    min-height: 0 !important;
    height: auto !important;
    margin-bottom: 0 !important;
    padding-bottom: 0 !important;
    overflow: hidden !important;
}

.dashboard-command-workspace > .dashboard-panel {
    box-sizing: border-box;
    min-height: 0 !important;
    height: auto !important;
    margin-bottom: 0 !important;
    overflow: hidden !important;
}

/* Only the panel contents scroll, with no extra space behind the footer */
.dashboard-panel-body,
.dashboard-activity-list {
    min-height: 0 !important;
    padding-bottom: 12px !important;
    scroll-padding-bottom: 12px !important;
    overflow-x: hidden !important;
    overflow-y: auto !important;
    overscroll-behavior: contain;
}

/* Entire dashboard rows are clickable */
.dashboard-action-row,
.dashboard-activity-row {
    position: relative;
    cursor: pointer;
}

a.dashboard-row-link {
    position: absolute !important;
    inset: 0 !important;
    z-index: 2 !important;
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    border: 0 !important;
    border-radius: inherit;
    background: transparent !important;
    box-shadow: none !important;
    color: transparent !important;
    font-size: 0 !important;
    line-height: 0 !important;
    text-decoration: none !important;
}

a.dashboard-row-link:focus-visible {
    outline: 2px solid var(--brand, #0f766e) !important;
    outline-offset: -3px;
}