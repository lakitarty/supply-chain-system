.dashboard-page {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: none;
    min-width: 0;
    min-height: 0;
    margin: 0;
    padding: 13px clamp(14px, 1.7vw, 24px) 8px;
    overflow: hidden;
    color: #17262b;
    background: #fff;
}

.dashboard-page *,
.dashboard-page *::before,
.dashboard-page *::after {
    box-sizing: border-box;
}

.dashboard-page .form-message:empty {
    display: none;
}

.dashboard-page > #dashboardMessage:not(:empty) {
    flex: 0 0 auto;
    margin: 0 0 9px;
}

.dashboard-page > .dashboard-alert-warning {
    flex: 0 0 auto;
    margin-bottom: 9px;
}

.dashboard-card-grid {
    display: flex;
    flex: 1 1 0;
    width: 100%;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

.dashboard-command-center {
    display: flex;
    flex: 1 1 0;
    width: 100%;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

.dashboard-layout {
    display: grid;
    flex: 1 1 0;
    grid-template-columns:
        minmax(178px, .78fr)
        minmax(410px, 1.7fr)
        minmax(205px, .92fr);
    width: 100%;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    border-top: 1px solid #e2e8e9;
}

.dashboard-region {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    padding: 15px 17px 10px;
}

.dashboard-region + .dashboard-region {
    border-left: 1px solid #e5eaeb;
}

.dashboard-region-heading {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 26px;
    margin-bottom: 12px;
}

.dashboard-region-label {
    margin: 0;
    color: #263a40;
    font-size: 13px;
    line-height: 1.35;
    font-weight: 750;
    letter-spacing: -.015em;
}

.dashboard-region-count {
    color: #78878b;
    font-size: 10px;
    line-height: 1;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
}

.dashboard-region-body {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: #d6dfe0 transparent;
}

.dashboard-region-body::-webkit-scrollbar {
    width: 5px;
}

.dashboard-region-body::-webkit-scrollbar-thumb {
    border-radius: 5px;
    background: #d6dfe0;
}

.dashboard-region-body::-webkit-scrollbar-track {
    background: transparent;
}

/* Rotating previews */

.dashboard-rotator {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-width: 0;
    min-height: 112px;
}

.dashboard-rotator-viewport {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
    min-height: 108px;
}

.dashboard-preview-item {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    width: 100%;
    min-width: 0;
    min-height: 86px;
    padding: 11px 9px;
    border: 1px solid transparent;
    border-bottom-color: #edf0f1;
    border-radius: 3px;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    animation: dashboard-preview-in 200ms ease-out both;
}

.dashboard-preview-item:hover {
    border-bottom-color: #dce8e5;
    background: #f7faf9;
}

.dashboard-preview-item:focus-visible {
    outline: 2px solid var(--brand, #0f766e);
    outline-offset: -2px;
}

.dashboard-preview-copy {
    flex: 1 1 auto;
    min-width: 0;
}

.dashboard-preview-kind {
    display: block;
    margin-bottom: 5px;
    color: #438078;
    font-size: 9px;
    line-height: 1.25;
    font-weight: 750;
    letter-spacing: .055em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
}

.dashboard-preview-title {
    color: #20343a;
    font-size: 12px;
    line-height: 1.45;
    font-weight: 700;
    overflow-wrap: anywhere;
}

.dashboard-preview-detail {
    margin: 5px 0 0;
    color: #5c6b70;
    font-size: 11px;
    line-height: 1.55;
    overflow-wrap: anywhere;
}

.dashboard-preview-meta {
    margin: 7px 0 0;
    color: #899599;
    font-size: 9px;
    line-height: 1.45;
    overflow-wrap: anywhere;
}

.dashboard-preview-image-frame {
    display: flex;
    flex: 0 0 50px;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    overflow: hidden;
    border: 1px solid #edf0f0;
    border-radius: 3px;
    background: #f7f8f8;
}

.dashboard-preview-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
}

/* Operations */

.dashboard-operations {
    padding-right: 19px;
    padding-left: 19px;
}

.dashboard-sales-summary {
    display: grid;
    flex: 0 0 auto;
    grid-template-columns: minmax(0, 1fr);
    gap: 5px;
    margin-bottom: 15px;
    padding: 11px 13px 12px;
    border-left: 3px solid #31867d;
    background: #f5f8f7;
    color: inherit;
    text-decoration: none;
}

.dashboard-sales-summary:hover {
    background: #eef5f3;
}

.dashboard-sales-summary:focus-visible {
    outline: 2px solid var(--brand, #0f766e);
    outline-offset: 2px;
}

.dashboard-sales-label {
    color: #5a6d70;
    font-size: 10px;
    line-height: 1.4;
    font-weight: 650;
}

.dashboard-sales-value {
    color: #183b3a;
    font-size: clamp(19px, 2vw, 25px);
    line-height: 1.25;
    font-weight: 750;
    letter-spacing: -.025em;
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
}

.dashboard-sales-detail {
    color: #718184;
    font-size: 10px;
    line-height: 1.45;
}

.dashboard-operations-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: 16px;
    min-width: 0;
}

.dashboard-operation {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    border-top: 1px solid #e5eaea;
}

.dashboard-operation-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: 37px;
    padding: 8px 2px 7px;
}

.dashboard-operation-title {
    margin: 0;
    color: #405459;
    font-size: 10px;
    line-height: 1.4;
    font-weight: 750;
    letter-spacing: .035em;
    text-transform: uppercase;
}

.dashboard-operation-count {
    color: #8a979a;
    font-size: 9px;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
}

.dashboard-operation .dashboard-rotator {
    min-height: 105px;
}

.dashboard-operation .dashboard-rotator-viewport {
    min-height: 105px;
}

.dashboard-operation .dashboard-preview-item {
    min-height: 92px;
    padding: 9px 6px;
}

.dashboard-operation .dashboard-preview-title {
    font-size: 11px;
}

.dashboard-operation .dashboard-preview-detail {
    font-size: 10px;
}

/* Loading, empty and error states */

.dashboard-empty {
    margin: 0;
    padding: 18px 12px;
    color: #738185;
    font-size: 11px;
    line-height: 1.65;
}

.dashboard-load-error {
    border: 1px solid #efc4c2;
    background: #fdf0ef;
    color: #a13732;
}

.dashboard-alert-warning {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 13px;
    margin: 0 0 9px;
    padding: 10px 13px;
    border: 1px solid #e5c985;
    border-left: 3px solid #bd8529;
    background: #fff9eb;
    color: #79571c;
    font-size: 11px;
    line-height: 1.55;
}

.dashboard-alert-warning strong {
    font-weight: 750;
}

.dashboard-alert-warning .dashboard-row-action {
    margin-left: auto;
    color: #79571c;
    font-size: 10px;
    font-weight: 750;
    text-decoration: none;
}

.dashboard-alert-warning .dashboard-row-action:hover {
    text-decoration: underline;
}

/* Smaller desktop windows */

@media (max-width: 1100px) {
    .dashboard-page {
        padding-right: 10px;
        padding-left: 10px;
    }

    .dashboard-region {
        padding-right: 11px;
        padding-left: 11px;
    }

    .dashboard-operations {
        padding-right: 13px;
        padding-left: 13px;
    }

    .dashboard-layout {
        grid-template-columns:
            minmax(170px, .76fr)
            minmax(390px, 1.7fr)
            minmax(190px, .9fr);
    }

    .dashboard-operations-grid {
        gap: 10px;
    }
}

/* Narrow layouts use a vertical workspace rather than compressing records. */

@media (max-width: 899px) {
    .dashboard-page {
        display: block;
        height: auto;
        overflow: visible;
        padding: 14px;
    }

    .dashboard-card-grid,
    .dashboard-command-center {
        display: block;
        overflow: visible;
    }

    .dashboard-layout {
        display: flex;
        flex-direction: column;
        overflow: visible;
    }

    .dashboard-region {
        min-height: 180px;
        padding: 14px 4px;
        overflow: visible;
    }

    .dashboard-region + .dashboard-region {
        border-top: 1px solid #e5eaeb;
        border-left: 0;
    }

    .dashboard-region-body {
        overflow: visible;
    }

    .dashboard-operations-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 560px) {
    .dashboard-operations-grid {
        grid-template-columns: minmax(0, 1fr);
    }

    .dashboard-alert-warning .dashboard-row-action {
        margin-left: 0;
    }
}

@keyframes dashboard-preview-in {
    from {
        opacity: 0;
    }

    to {
        opacity: 1;
    }
}

@media (prefers-reduced-motion: reduce) {
    .dashboard-preview-item {
        animation: none;
    }
}