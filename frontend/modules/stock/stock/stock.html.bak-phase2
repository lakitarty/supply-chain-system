<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../../../shared/css/base.css">
    <link rel="stylesheet" href="../../../shared/css/shell.css">
    <link rel="stylesheet" href="stock.css">
    <title>Stock | Nexora MSRC</title>
</head>
<body>
    <div id="shell"></div>

    <main class="page stock-page">
        <header class="stock-page-heading">
            <div>
                <h1>Stock</h1>
            </div>
            
        </header>

        <section class="stock-toolbar" aria-label="Stock filters">
            <div class="stock-field stock-branch-field">
                <label for="stockBranch">Branch</label>
                <select id="stockBranch" name="branchId"></select>
            </div>
            <div class="stock-field stock-search-field">
                <label for="stockSearch">Find product</label>
                <input id="stockSearch" type="search" placeholder="Product, barcode, manufacturer">
            </div>
            <div class="stock-field stock-filter-field">
                <label for="stockStatusFilter">Status</label>
                <select id="stockStatusFilter">
                    <option value="ALL">All stock</option>
                    <option value="NOT_TRACKED">Not tracked</option>
                    <option value="NORMAL">Normal</option>
                    <option value="LOW_STOCK">Low stock</option>
                    <option value="OUT_OF_STOCK">Out of stock</option>
                </select>
            </div>
        </section>

        <p id="stockStatus" class="stock-status-message" role="status" aria-live="polite">Loading stock...</p>

        <section id="stockMetrics" class="stock-metrics" aria-label="Stock summary"></section>
        <div class="stock-layout">
                    <section class="stock-product-panel" aria-labelledby="stockTableTitle">
            <header class="stock-section-heading">
                <div>
                    <h2 id="stockTableTitle">Selected product</h2>
                    <p>Search and choose one product package to view its inventory and supply guidance.</p>
                </div>
                <span id="stockRowCount" class="stock-row-count">0 matching packages</span>
            </header>

            <section id="stockInlineAlerts" class="stock-inline-alerts" aria-label="Stock alerts">
                <header class="stock-inline-alert-heading">
                    <div>
                        <h3>Needs attention</h3>
                        <p>Active stock alerts for this branch</p>
                    </div>
                    <span id="stockInlineAlertCount" class="stock-inline-alert-count">Loading</span>
                </header>
                <div id="stockInlineAlertSummary" class="stock-inline-alert-summary"></div>
                <div id="stockInlineAlertList" class="stock-inline-alert-list" aria-live="polite">
                    <p class="stock-inline-alert-empty">Loading active alerts...</p>
                </div>
            </section>
            <div class="stock-product-selector">
                <label for="stockProductSelect">Product and package version</label>
                <select id="stockProductSelect" aria-describedby="stockProductSelectHint">
                    <option value="">Choose a product package</option>
                </select>
                <p id="stockProductSelectHint">Use the search and status filters above to narrow the choices.</p>
            </div>

            <div id="stockProductSummary" class="stock-product-summary" aria-live="polite">
                <div class="stock-product-empty">
                    <strong>Choose a product to begin</strong>
                    <p>Its stock count, demand, supplier guidance, and status will appear here.</p>
                </div>
            </div>
        </section>

            <aside class="stock-editor" aria-labelledby="stockEditorTitle">
                <div class="stock-section-heading stock-editor-heading">
                    <div>
                        <h2 id="stockEditorTitle">Manage selected product</h2>
                        <p id="selectedProductLabel">Choose a product version from the table.</p>
                    </div>
                </div>

                <form id="stockCountForm" class="stock-form">
                    <h3>Count stock</h3>
                    <p class="stock-form-help">Enter a physical count and the level that should trigger a reorder.</p>
                    <div class="stock-form-grid">
                        <div class="stock-field">
                            <label for="countOnHand">Units on hand</label>
                            <input id="countOnHand" name="onHand" type="number" min="0" max="999999999" step="1" inputmode="numeric" required>
                        </div>
                        <div class="stock-field">
                            <label for="countReorderLevel">Reorder level</label>
                            <input id="countReorderLevel" name="reorderLevel" type="number" min="0" max="999999999" step="1" inputmode="numeric" required>
                        </div>
                    </div>
                    <button id="saveStockButton" class="primary-button" type="submit" disabled>Save stock count</button>
                </form>

                <div class="stock-form-divider"></div>

                <form id="stockSaleForm" class="stock-form">
                    <h3>Daily sales summary</h3>
                    <p class="stock-form-help">Enter one daily total for this branch, product version, and date. Saving the same date again corrects the existing summary rather than duplicating it.</p>
                    <div class="stock-field">
                        <label for="unitsSold">Units sold</label>
                        <input id="unitsSold" name="unitsSold" type="number" min="0" max="999999999" step="1" inputmode="numeric" required>
                    </div>
                    <div class="stock-field">
                        <label for="salesAmount">Total sales amount (KSh)</label>
                        <input id="salesAmount" name="salesAmount" type="number" min="0" max="9999999999.99" step="0.01" inputmode="decimal" required>
                        <p id="salesAmountHint" class="stock-form-help">Enter the actual total for the selected day, including any promotions or discounts.</p>
                    </div>
                    <div class="stock-field">
                        <label for="salesAmountBasis">Amount basis</label>
                        <select id="salesAmountBasis" name="salesAmountBasis" required>
                            <option value="">Choose amount basis</option>
                            <option value="VAT_INCLUSIVE">Amount includes VAT</option>
                            <option value="VAT_EXCLUSIVE">Amount excludes VAT</option>
                        </select>
                        <p class="stock-form-help">Choose how the entered total is recorded. Nexora will not guess this.</p>
                    </div>
                    <div id="salesTaxContext" class="stock-sales-tax-context" role="status" aria-live="polite">Select a product version and sale date to check its effective branch price and manufacturer tax declaration.</div>
                    <div class="stock-field">
                        <label for="saleDate">Sale date</label>
                        <input id="saleDate" name="saleDate" type="date" required>
                    </div>
                    <button id="recordSaleButton" class="secondary-button stock-full-button" type="submit" disabled>Record sale</button>
                </form>
                <p id="stockEditorStatus" class="stock-editor-status" role="status" aria-live="polite"></p>
            </aside>
        </div>
</main>

    <script src="../../../shared/js/api.js"></script>
    <script src="../../../shared/js/navigation.js"></script>
    <script src="../../../shared/js/shell.js"></script>
    <script src="../../../shared/js/page-router.js"></script>
    <script src="stock.js"></script>
</body>
</html>
