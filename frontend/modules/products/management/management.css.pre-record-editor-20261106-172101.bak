.product-management-page {
    width: min(100% - 64px, 1120px);
    margin: 0 auto;
    padding: 27px 0 44px;
    color: #18231d;
}

.product-management-page > .page-title {
    margin: 0 0 23px;
    color: #18231d;
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.45px;
}

/* Product selector */

.product-management-page > .page-section:first-of-type {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    align-items: center;
    gap: 7px 22px;
    max-width: 940px;
    margin: 0 0 25px;
    padding: 12px 15px;
    background: #f1f3ec;
}

.product-management-page > .page-section:first-of-type .section-title {
    grid-column: 1;
    grid-row: 1 / 3;
    margin: 0;
    color: #bf6835;
    font-size: 13px;
    font-weight: 700;
}

.product-management-page > .page-section:first-of-type .form-group {
    grid-column: 2;
    max-width: 610px;
    margin: 0;
}

.product-management-page > .page-section:first-of-type .field-hint {
    grid-column: 2;
    margin: 0;
}

/* Main form */

.product-management-page > .page-section:nth-of-type(2) {
    max-width: 940px;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
}

.product-management-page > .page-section:nth-of-type(2) > .section-title {
    margin: 0 0 18px;
    padding: 0;
    color: #18231d;
    font-size: 20px;
    font-weight: 700;
}

/* Identity: details on the left, image on the right */

.product-management-page .product-identity-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 225px;
    align-items: start;
    gap: 26px;
    max-width: 940px;
    margin: 0 0 25px;
    padding: 15px 17px;
    background: #f5f5ef;
    border-radius: 5px;
}

.product-management-page .product-identity-details {
    min-width: 0;
}

.product-management-page .product-identity-inputs {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
}

.product-management-page .product-image-panel {
    min-width: 0;
}

.product-management-page .form-grid-heading {
    grid-column: 1 / -1;
    margin: 0 0 13px;
    color: #bf6835;
    font-size: 11px;
    font-weight: 750;
    letter-spacing: 0.07em;
    line-height: 1.4;
    text-transform: uppercase;
}

.product-management-page .product-image-panel .form-grid-heading {
    margin-bottom: 13px;
}

.product-management-page #productImage {
    height: auto;
    min-height: 38px;
    padding: 6px;
    background: #ffffff;
    font-size: 11px;
}

.product-management-page #productImage::file-selector-button {
    margin-right: 7px;
    padding: 6px 8px;
    border: 0;
    border-radius: 3px;
    background: #e8eee8;
    color: #245344;
    font: inherit;
    font-weight: 650;
    cursor: pointer;
}

.product-management-page #imagePreviewContainer:not([hidden]) {
    margin-top: 10px;
}

.product-management-page #imagePreviewLabel {
    margin: 0 0 6px;
    color: #3e4b42;
    font-size: 11px;
}

.product-management-page #imagePreview {
    display: block;
    width: 100%;
    max-width: 190px;
    height: 135px;
    object-fit: contain;
    border: 0;
    border-radius: 3px;
    background: #ffffff;
}

/* Setup and commercial fields */

.product-management-page #productForm .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 27px;
    row-gap: 16px;
    max-width: 940px;
}

.product-management-page #productForm .form-grid > .form-grid-heading {
    margin: 13px 0 0;
}

.product-management-page #productForm .form-grid > .form-grid-heading:first-child {
    margin-top: 0;
}

.product-management-page .form-group {
    min-width: 0;
    margin: 0;
}

.product-management-page .form-group label {
    display: block;
    margin: 0 0 6px;
    color: #202a23;
    font-size: 12px;
    font-weight: 650;
    line-height: 1.4;
}

.product-management-page .form-group input,
.product-management-page .form-group select,
.product-management-page .form-group textarea {
    width: 100%;
    max-width: 100%;
    border: 1px solid #bac4bb;
    border-radius: 4px;
    background: #ffffff;
    color: #17231d;
    font-family: inherit;
    font-size: 13px;
    transition: border-color 140ms ease, box-shadow 140ms ease;
}

.product-management-page .form-group input,
.product-management-page .form-group select {
    height: 40px;
    padding: 0 10px;
}

.product-management-page .form-group textarea {
    min-height: 86px;
    padding: 10px;
    resize: vertical;
    line-height: 1.5;
}

.product-management-page .form-group input::placeholder,
.product-management-page .form-group textarea::placeholder {
    color: #566259;
    opacity: 1;
}

.product-management-page .form-group input:hover,
.product-management-page .form-group select:hover,
.product-management-page .form-group textarea:hover {
    border-color: #7e9183;
}

.product-management-page .form-group input:focus,
.product-management-page .form-group select:focus,
.product-management-page .form-group textarea:focus {
    border-color: #0f766e;
    outline: none;
    box-shadow: 0 0 0 2px rgba(15, 118, 110, 0.13);
}

.product-management-page .field-hint {
    margin: 6px 0 0;
    color: #465249;
    font-size: 11px;
    line-height: 1.45;
}

.product-management-page .optional {
    color: #465249;
    font-size: 11px;
    font-weight: 400;
}

/* Description */

.product-management-page .form-detail-heading {
    margin: 23px 0 11px;
    color: #bf6835;
    font-size: 11px;
    font-weight: 750;
    letter-spacing: 0.07em;
    text-transform: uppercase;
}

.product-management-page #productForm > .form-group {
    max-width: 940px;
    margin: 0;
}

/* Actions */

.product-management-page #productMessage {
    max-width: 940px;
    margin-top: 12px;
}

.product-management-page .form-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 940px;
    margin-top: 20px;
    padding: 0;
    border: 0;
}

.product-management-page .form-actions .primary-button {
    width: auto;
    min-width: 150px;
    height: 40px;
    padding: 0 17px;
    border: 1px solid #0f766e;
    border-radius: 4px;
    background: #0f766e;
    color: #ffffff;
    font-size: 12px;
    font-weight: 650;
}

.product-management-page .form-actions .primary-button:hover {
    border-color: #115e59;
    background: #115e59;
}

.product-management-page #cancelEditButton {
    min-height: 40px;
    padding: 0 15px;
    border: 1px solid #87958b;
    border-radius: 4px;
    background: transparent;
    color: #26372d;
    font-family: inherit;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
}

.product-management-page #cancelEditButton:hover {
    background: #edf2ed;
}

.product-management-page button:focus-visible {
    outline: 2px solid rgba(15, 118, 110, 0.35);
    outline-offset: 2px;
}

.product-management-page [hidden] {
    display: none !important;
}