/* ChainBridge Product Updates register design */

.updates-page {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    width: 100%;
    max-width: none;
    height: 0;
    min-width: 0;
    min-height: 0;
    margin: 0;
    padding: 19px clamp(18px, 2.2vw, 34px) 16px;
    overflow: hidden;
    background: #f8f8f4;
    color: #171717;
}

.updates-page *,
.updates-page *::before,
.updates-page *::after {
    box-sizing: border-box;
}

.updates-page [hidden] {
    display: none !important;
}

.updates-shell {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    width: 100%;
    max-width: 1580px;
    min-width: 0;
    min-height: 0;
    margin: 0 auto;
    gap: 15px;
    overflow: hidden;
}

.updates-header {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-width: 0;
}

.updates-heading-copy {
    min-width: 0;
}

.updates-eyebrow {
    margin-bottom: 3px;
    color: #0f766e;
    font-size: 9px;
    line-height: 1.4;
    font-weight: 750;
    letter-spacing: .09em;
}

.updates-page-title {
    color: #bd6838;
    font-size: 23px;
    line-height: 1.2;
    font-weight: 750;
    letter-spacing: -.035em;
}

.updates-description {
    margin: 5px 0 0;
    color: #171717;
    font-size: 11px;
    line-height: 1.45;
}

.updates-prepare-toggle {
    flex: 0 0 auto;
    min-height: 36px;
    padding: 0 15px;
    border: 0;
    border-radius: 4px;
    background: #0f766e;
    color: #ffffff;
    font-family: inherit;
    font-size: 11px;
    font-weight: 650;
    cursor: pointer;
    transition: background-color 120ms ease;
}

.updates-prepare-toggle:hover {
    background: #115e59;
}

.updates-summary {
    display: grid;
    flex: 0 0 auto;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    padding: 10px 13px;
    border-radius: 5px;
    background: #eef1e9;
}

.updates-summary-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    padding: 2px 14px;
}

.updates-summary-label {
    color: #171717;
    font-size: 10px;
    line-height: 1.4;
    font-weight: 550;
}

.updates-summary-value {
    color: #0f766e;
    font-size: 21px;
    line-height: 1.2;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
}

.updates-summary-item.is-pending .updates-summary-value {
    color: #bd6838;
}

.updates-toolbar {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 10px;
    min-width: 0;
}

.updates-search-wrap {
    flex: 1 1 auto;
    min-width: 170px;
}

.updates-search,
.updates-filter {
    width: 100%;
    height: 36px;
    padding: 0 11px;
    border: 0;
    border-radius: 4px;
    outline: none;
    background: #eeefe9;
    color: #171717;
    font-family: inherit;
    font-size: 11px;
}

.updates-search::placeholder {
    color: #343b38;
    opacity: 1;
}

.updates-search:focus,
.updates-filter:focus {
    outline: 2px solid #0f766e;
    outline-offset: 1px;
    background: #ffffff;
}

.updates-filter {
    flex: 0 0 170px;
    cursor: pointer;
}

.updates-workspace {
    display: grid;
    flex: 1 1 0;
    grid-template-columns: minmax(275px, 340px) minmax(0, 1fr);
    gap: 27px;
    min-width: 0;
    min-height: 350px;
    overflow: hidden;
}

.updates-register {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    padding: 13px 11px;
    border-radius: 5px;
    background: #edf1e9;
    overflow: hidden;
}

.updates-register-heading {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 1px 5px 12px;
    color: #bd6838;
    font-size: 13px;
    line-height: 1.4;
    font-weight: 750;
}

.updates-register-count {
    color: #171717;
    font-size: 10px;
    font-weight: 550;
    font-variant-numeric: tabular-nums;
}

.updates-list {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    min-height: 0;
    gap: 5px;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: #9eafa0 transparent;
}

.updates-list::-webkit-scrollbar,
.updates-detail-panel::-webkit-scrollbar,
.updates-page .thread::-webkit-scrollbar {
    width: 5px;
}

.updates-list::-webkit-scrollbar-thumb,
.updates-detail-panel::-webkit-scrollbar-thumb,
.updates-page .thread::-webkit-scrollbar-thumb {
    border-radius: 5px;
    background: #9eafa0;
}

.updates-list-item {
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    width: 100%;
    min-width: 0;
    gap: 6px;
    padding: 11px 10px;
    border: 0;
    border-radius: 3px;
    background: transparent;
    color: #171717;
    font-family: inherit;
    text-align: left;
    cursor: pointer;
    transition: background-color 110ms ease;
}

.updates-list-item:hover {
    background: #e4eae0;
}

.updates-list-item.is-selected {
    background: #dce9e1;
    box-shadow: inset 3px 0 0 #0f766e;
}

.updates-list-item:focus-visible {
    outline: 2px solid #0f766e;
    outline-offset: -2px;
}

.updates-list-item-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-width: 0;
}

.updates-list-direction {
    min-width: 0;
    color: #bd6838;
    font-size: 8px;
    line-height: 1.35;
    font-weight: 750;
    letter-spacing: .045em;
    overflow-wrap: anywhere;
}

.updates-list-status,
.updates-status-badge {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    min-height: 21px;
    padding: 3px 8px;
    border-radius: 3px;
    background: #e5e9e3;
    color: #171717;
    font-size: 9px;
    line-height: 1.3;
    font-weight: 650;
}

.updates-list-status.is-published,
.updates-status-badge.is-published {
    background: #dcebe2;
    color: #145d4c;
}

.updates-list-status.is-pending-approval,
.updates-status-badge.is-pending-approval {
    background: #f4e7d8;
    color: #8a4d25;
}

.updates-list-status.is-rejected,
.updates-status-badge.is-rejected {
    background: #f1dfdc;
    color: #8c3029;
}

.updates-list-product {
    color: #171717;
    font-size: 12px;
    line-height: 1.4;
    font-weight: 700;
    overflow-wrap: anywhere;
}

.updates-list-meta {
    color: #171717;
    font-size: 9px;
    line-height: 1.45;
    overflow-wrap: anywhere;
}

.updates-detail-panel {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    padding: 5px 9px 15px 2px;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: #9eafa0 transparent;
}

.updates-detail-empty {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 250px;
    padding: 30px;
    text-align: center;
}

.updates-empty-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    margin-bottom: 13px;
    border-radius: 50%;
    background: #e4eee7;
    color: #0f766e;
    font-size: 21px;
}

.updates-empty-title {
    color: #bd6838;
    font-size: 15px;
    font-weight: 750;
}

.updates-detail-empty p {
    max-width: 340px;
    margin: 7px 0 0;
    color: #171717;
    font-size: 11px;
    line-height: 1.6;
}

.updates-detail-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 3px 0 18px;
}

.updates-detail-heading-copy {
    min-width: 0;
}

.updates-detail-kicker {
    margin-bottom: 5px;
    color: #bd6838;
    font-size: 9px;
    line-height: 1.4;
    font-weight: 750;
    letter-spacing: .08em;
}

.updates-detail-title {
    color: #171717;
    font-size: 20px;
    line-height: 1.3;
    font-weight: 750;
    letter-spacing: -.025em;
    overflow-wrap: anywhere;
}

.updates-detail-subtitle {
    margin-top: 6px;
    color: #171717;
    font-size: 10px;
    line-height: 1.45;
}

.updates-status-badge {
    margin-top: 15px;
}

.updates-detail-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.updates-section-heading {
    color: #bd6838;
    font-size: 13px;
    line-height: 1.4;
    font-weight: 750;
}

.updates-page .detail-list {
    display: grid;
    grid-template-columns: minmax(125px, .35fr) minmax(0, 1fr);
    gap: 10px 20px;
    width: 100%;
    max-width: 900px;
    margin: 0;
    padding: 7px 0;
    border: 0;
}

.updates-page .detail-list dt,
.updates-page .detail-list dd {
    min-width: 0;
    margin: 0;
    padding: 2px 0;
    border: 0;
    background: transparent;
    color: #171717;
    font-size: 11px;
    line-height: 1.5;
    overflow-wrap: anywhere;
}

.updates-page .detail-list dt {
    font-weight: 650;
}

.updates-page .detail-list dd {
    font-weight: 450;
}

.updates-actions-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
}

.updates-page .form-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 8px;
}

.updates-page .form-actions .primary-button {
    width: auto;
    min-width: 135px;
    height: 36px;
    padding: 0 14px;
    border: 0;
    border-radius: 4px;
    background: #0f766e;
    color: #ffffff;
    font-family: inherit;
    font-size: 11px;
    font-weight: 650;
    cursor: pointer;
}

.updates-page .form-actions .primary-button:hover {
    background: #115e59;
}

.updates-page .form-actions .primary-button:disabled {
    opacity: .6;
    cursor: not-allowed;
}

.updates-action-note {
    margin: 0;
    color: #171717;
    font-size: 10px;
    line-height: 1.5;
}

.updates-discussion {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 22px;
}

.updates-page .thread {
    width: 100%;
    max-width: 100%;
    max-height: 190px;
    margin: 0;
    padding: 8px 0;
    overflow-y: auto;
    border: 0;
    border-radius: 0;
    background: #f0f3ed;
}

.updates-page .message-line {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin: 0;
    padding: 9px 12px;
    border: 0;
    color: #171717;
}

.updates-page .message-meta {
    color: #171717;
    font-size: 9px;
    line-height: 1.4;
    font-weight: 650;
}

.updates-page .message-line > span:last-child {
    color: #171717;
    font-size: 11px;
    line-height: 1.5;
    overflow-wrap: anywhere;
}

.updates-message-form {
    display: flex;
    align-items: flex-end;
    gap: 12px;
    max-width: 900px;
    margin-top: 2px;
}

.updates-message-form .form-group {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
}

.updates-page .form-group label {
    display: block;
    margin-bottom: 5px;
    color: #171717;
    font-size: 10px;
    font-weight: 650;
}

.updates-page .form-group input,
.updates-page .form-group select,
.updates-page .form-group textarea {
    width: 100%;
    min-width: 0;
    height: 36px;
    padding: 0 10px;
    border: 0;
    border-radius: 4px;
    outline: none;
    background: #eeefe9;
    color: #171717;
    font-family: inherit;
    font-size: 11px;
}

.updates-page .form-group textarea {
    height: auto;
    min-height: 80px;
    padding: 9px 10px;
    resize: vertical;
}

.updates-page .form-group input::placeholder,
.updates-page .form-group textarea::placeholder {
    color: #343b38;
    opacity: 1;
}

.updates-page .form-group input:focus,
.updates-page .form-group select:focus,
.updates-page .form-group textarea:focus {
    outline: 2px solid #0f766e;
    outline-offset: 1px;
    background: #ffffff;
}

.updates-message-form .form-actions {
    flex: 0 0 auto;
    margin: 0;
}

.updates-page .form-message {
    margin: 8px 0;
}

.updates-page .field-hint {
    color: #171717;
    font-size: 10px;
}

.updates-prepare {
    flex: 0 0 auto;
    max-height: 40%;
    padding: 15px 17px;
    border-radius: 5px;
    background: #f0f1e9;
    overflow-y: auto;
}

.updates-prepare-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 13px;
}

.updates-form-context {
    color: #0f766e;
    font-size: 8px;
    line-height: 1.4;
    font-weight: 750;
    letter-spacing: .07em;
}

.updates-prepare .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 20px;
}

.updates-prepare .form-group {
    min-width: 0;
    margin-bottom: 11px;
}

.updates-native-select,
.updates-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}

.updates-empty {
    margin: 0;
    padding: 15px 10px;
    color: #171717;
    font-size: 10px;
    line-height: 1.5;
}

.updates-page button:focus-visible {
    outline: 2px solid #0f766e;
    outline-offset: 2px;
}

.updates-page input:focus-visible,
.updates-page select:focus-visible {
    outline: 2px solid #0f766e;
    outline-offset: 1px;
}

.acknowledgement-overlay {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(20, 35, 32, .42);
}

.acknowledgement-dialog {
    width: min(100%, 600px);
    max-height: 80vh;
    padding: 22px;
    border: 0;
    border-radius: 6px;
    background: #faf9f5;
    box-shadow: 0 14px 40px rgba(20, 35, 32, .18);
    overflow-y: auto;
}

.acknowledgement-dialog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 12px;
}

.acknowledgement-dialog-title {
    margin: 0;
    color: #bd6838;
    font-size: 16px;
    font-weight: 750;
}

.acknowledgement-close-button {
    min-height: 32px;
    padding: 6px 11px;
    border: 0;
    border-radius: 4px;
    background: #e8eee8;
    color: #0f766e;
    font: inherit;
    font-size: 10px;
    font-weight: 650;
    cursor: pointer;
}

.acknowledgement-dialog-summary {
    margin: 10px 0;
    color: #171717;
    font-size: 11px;
}

.acknowledgement-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
}

.acknowledgement-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 5px 16px;
    padding: 10px;
    border: 0;
    border-radius: 3px;
    background: #eef1e9;
}

.acknowledgement-organization {
    color: #171717;
    font-size: 11px;
    font-weight: 650;
}

.acknowledgement-status {
    align-self: start;
    color: #171717;
    font-size: 10px;
    font-weight: 650;
}

.acknowledgement-status.is-acknowledged {
    color: #0f766e;
}

.acknowledgement-status.is-pending {
    color: #bd6838;
}

.acknowledgement-date {
    grid-column: 1 / -1;
    color: #171717;
    font-size: 9px;
}

@media (max-width: 1000px) {
    .updates-page {
        padding-inline: 14px;
    }

    .updates-workspace {
        grid-template-columns: minmax(245px, 30%) minmax(0, 1fr);
        gap: 18px;
    }

    .updates-summary-item {
        padding-inline: 8px;
    }
}

@media (max-width: 760px) {
    .updates-page {
        height: auto;
        min-height: 0;
        overflow: visible;
    }

    .updates-shell {
        min-height: 0;
        overflow: visible;
    }

    .updates-toolbar {
        flex-wrap: wrap;
    }

    .updates-search-wrap {
        flex-basis: 100%;
    }

    .updates-filter {
        flex: 1 1 0;
    }

    .updates-workspace {
        display: flex;
        flex-direction: column;
        min-height: 0;
        overflow: visible;
    }

    .updates-register {
        min-height: 280px;
        max-height: 360px;
    }

    .updates-detail-panel {
        min-height: 360px;
        overflow: visible;
    }

    .updates-summary {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        row-gap: 10px;
    }
}

@media (max-width: 540px) {
    .updates-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .updates-page-title {
        font-size: 20px;
    }

    .updates-summary {
        padding: 9px 7px;
    }

    .updates-summary-item {
        padding-inline: 7px;
    }

    .updates-page .detail-list {
        grid-template-columns: minmax(0, 1fr);
        gap: 3px;
    }

    .updates-page .detail-list dd {
        padding-bottom: 6px;
    }

    .updates-prepare .form-grid {
        grid-template-columns: minmax(0, 1fr);
    }

    .updates-message-form {
        align-items: stretch;
        flex-direction: column;
    }

    .updates-message-form .form-actions {
        align-self: flex-start;
    }
}

@media (prefers-reduced-motion: reduce) {
    .updates-list-item,
    .updates-prepare-toggle {
        transition: none;
    }
}